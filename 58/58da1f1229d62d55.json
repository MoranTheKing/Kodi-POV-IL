{"c":[[1460,3810,"לא משנה מה הבית הזה מנסה לגרום לך להאמין,"],[3860,5940,"או מה שאת חושבת שאת."],[7460,11600,"אנחנו תמיד נהיה יחד, אמא, לא משנה מה."],[11690,13060,"*מוזיקה*"],[14940,16129,"השכנה ממול באה"],[16180,18000,"לבקר אתכן."],[18700,19730,"אבל אנחנו עומדות לאחר,"],[19780,22440,"וזה היום הראשון שלך בבית הספר."],[22580,24290,"אני עדיין קצת אבודה,"],[24340,27200,"אבל מקווה להסתגל מהר ולהכיר אתכן."],[27940,29570,"אמא, אני אוהבת אותך."],[37980,40530,"קרלה, הייתה שמלה שסתמה את הניקוז."],[40580,41610,"של מי היא?"],[41660,42880,"שלי."],[45340,45970,"זה התחיל."],[46020,46490,"מה התחיל?"],[46540,48320,"הדברים המוזרים."],[48660,50570,"באמת שקורים כאן דברים מאוד מוזרים."],[50620,52460,"הבית מדבר אלייך."],[57020,58810,"אוקיי, אני לא רוצה להיות אמא קרצייה,"],[58860,61170,"אבל זו פעם ראשונה שאת טורקת לי את הדלת בפנים, חמודה."],[61220,63060,"זו לא הייתי אני."],[64260,67120,"וואו, עכשיו יש לנו יצורים קסומים."],[71060,72920,"לבתים יש זיכרון."],[74100,76290,"קרו כאן דברים נוראיים."],[77980,79130,"איזה דברים?"],[79180,79760,"מי עשה לך את זה?"],[79810,80210,"*צחוק*"],[82900,83930,"אני מפחדת על הבת שלי."],[83980,85290,"את חושבת שקרלה בסכנה?"],[85340,87620,"אני חושבת שהיא כבר עברה את שלב האמונה, לא?"],[87670,89040,"*מוזיקה*"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"El vestido","y":2026,"k":"movie","f":2,"ts":1795288191}