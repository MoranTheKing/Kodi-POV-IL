{"c":[[8980,11440,"אנחנו מכירים שבע שנים."],[15780,19890,"אנחנו פה רק לכמה ימים, אז בואו ננצל את הזמן שנותר."],[19940,23370,"הספירה לאחור מתחילה, חברים."],[23420,24670,"אוקיי."],[27620,34720,"איזה סוג של משחקים אלו?"],[41860,43690,"תלוי אם אתם בעניין."],[43740,50840,"שני אנשים רנדומליים, אה, זה מסובך."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Lunok","y":2026,"k":"movie","f":2,"ts":1795370401}