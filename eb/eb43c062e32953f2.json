{"c":[[420,4290,"זה היה חג מולד עליז כשהכרתי את הלהקה שלי."],[4290,6170,"הו, מי אתה?"],[6170,8119,"הוא היה אבא שלי."],[8119,9500,"סבא, גור."],[9500,11790,"זו הייתה אהבה ממבט ראשון."],[15290,16420,"אבל עכשיו..."],[16420,20040,"עברו שנתיים מאז שאמא הלכה."],[24120,26500,"קדימה, אבא. אנחנו עושים זומים!"],[26500,27920,"לא הייתי במצב רוח טוב לאחרונה."],[27920,28960,"כן, בעדינות... בערך לנצח."],[28960,30790,"אני לא מבין למה אתה לא יכול להיות נחמד"],[30790,32619,"כמו כל סבא אחר בעולם."],[33250,35710,"אם רק הייתי יכול לגרום להם לשחק יחד"],[35710,37790,"אולי הם ייזכרו שהם אוהבים זה את זה."],[39620,41290,"נראה לי שאני מוכן לקינוח."],[41290,43500,"בחייך, זה היה שוק ההודו שלי."],[47250,48000,"מי זו?"],[48000,50580,"לא סבתא, הוא אולי רווק נחשק."],[52120,53460,"איך קוראים לכלב שלך?"],[53460,54540,"וינסטד."],[55420,56330,"היא מריחה כמו סוכר."],[56330,58750,"אנחנו צריכים לקחת אותה הביתה."],[58750,61380,"הנשים האלה, הן אמרו שאני נראה פרוע."],[61380,62330,"נשים?"],[62330,63040,"תפסיק לגעת."],[63040,66000,"הוא לא אוהב טיפוח יותר ממני."],[66710,67790,"גור!"],[67790,70960,"הלו! אין לך קולר?"],[70960,72330,"אני אקח אותך הביתה, בסדר?"],[74460,75290,"אני צריכה לדבר איתך."],[75790,76460,"מה?"],[76750,78420,"אמא שלך חולה מאוד."],[79250,80580,"כשסבתא שלך הייתה חולה,"],[81040,83420,"וינסטד היא זו שהצילה אותי."],[84540,86380,"ואנחנו נישאר יחד כמשפחה"],[86380,88210,"כי זה מה שמשפחות עושות."],[96710,99880,"צריך להכין את הבית לחג בשביל כשהיא תחזור."],[99880,102920,"לרובי ולי אין מושג מה אנחנו עושים,"],[102920,105170,"אבל אנחנו עושים כמיטב יכולתנו לעזור."],[105460,107290,"זה סימן. אמא תהיה בסדר."],[108080,109170,"הו, רובי."],[109170,110460,"כלב רע."],[111000,113380,"הייעוד של כלב הוא לשמח אנשים."],[115000,117750,"ורובי ואני? אנחנו מצוינים בזה."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"חג המולד המושלם של וינסטד","y":2026,"k":"movie","f":2,"ts":1795559750}