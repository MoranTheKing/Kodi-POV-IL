{"c":[[23420,26200,"אנובה? מסאמאיאן."],[26260,27720,"אנוקאבה?"],[27780,29290,"רק לנו מותר."],[29340,32640,"הידיים מלוכלכות, אבל הלב יכול."],[40620,47720,"מרתה, החלטנו להביא עוזרת בית חדשה שתהיה איתך."],[50380,52490,"חסר משהו בעבודה שלי?"],[52540,56360,"כי אני יכולה לעשות את כל עבודות הבית כאן."],[57260,60120,"אני אציג לך את השותפה החדשה שלך."],[60500,65370,"הארלי. מרתה. מרתה, זו..."],[65420,67130,"קשה להיות עוזרת, נכון?"],[67180,69570,"אמרת שיש לך בית משלך."],[69620,70690,"אבל הוא לא שלך."],[70740,72330,"יש לך עבודה, באמת."],[72380,74960,"אבל את לא יודעת לכמה זמן."],[77620,79360,"את ממהרת מדי."],[79580,83680,"עוד מעט נחליף את המעסיקים שלי ושל מרתה כאן."],[85820,88370,"גברת, למה את צריכה שמישהו יעשה את זה?"],[88420,89650,"אמא שלך, אה."],[89700,91370,"מה? כבר נקמת?"],[91420,93140,"אנחנו רק כלים."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Maid's Obsession","y":2026,"k":"movie","f":2,"ts":1795850739}