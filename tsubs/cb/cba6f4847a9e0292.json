{"c":[[1070,3990,"הרחק בצפון הרחוק, עמד פעם יער קסום.|"],[4040,8330,"את רואה? יער קסום. כן, זה היה מקום קסום.|"],[8380,13490,"אבל משהו השתבש, ומאז אף אחד לא יכול להיכנס או לצאת.|"],[13540,17590,"מה הייתי עושה בלעדייך?|"],[24040,26280,"תמיד יהיה לך אותי.|"],[26330,32960,"אלזה, את נראית מוזר. את נראית כמו אלזה.|"],[33010,37670,"יש לי קול בראש. קול?|"],[37720,39630,"מה זה אומר?|"],[50340,54210,"הממלכה בסכנה.|"],[56040,58670,"תגלי מי קורא לך.|"],[58720,60770,"אולי להם יש תשובות.|"],[60820,62720,"אני באה איתך, אנה.|"],[62770,63320,"לא.|"],[63370,64970,"סליחה? טיפסתי להר הצפוני,|"],[65019,67220,"שרדתי לב קפוא, והצלתי אותך מהאקס שלי.|"],[67270,70170,"אז את יודעת שאני באה.|"],[71650,73380,"זה נורמלי.|"],[75780,78240,"איפה אנחנו?|"],[79200,80900,"איך נכנסתם ליער?|"],[80950,82550,"הערפל נפתח עבורנו.|"],[82600,83960,"בלתי אפשרי.|"],[84010,86190,"איפה למדת קסם?|"],[93220,95490,"את לא יכולה לעקוב אחריי לאש.|"],[95540,98590,"אז אל תרוצי לאש.|"],[102640,104360,"הקסם מפתה מאוד.|"],[104410,108330,"בלעדייך, היא עלולה לאבד את עצמה בתוכו.|"],[110850,113540,"הגני על ארנדל בכל מחיר.|"],[114120,117860,"אני מאמינה בך, אלזה, יותר מכל אחד או מכל דבר.|"],[127150,132130,"שאלה מהירה: כל הקטע הזה של סכנת חיים... זה הולך להיות קבוע?|"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"לשבור את הקרח 2","y":2019,"k":"movie","f":2,"ts":1795675751}