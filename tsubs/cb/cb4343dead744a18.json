{"c":[[940,4650,"שמי קונרד הריאן, איש משפחה."],[4700,9050,"ואם תחצה את המשפחה שלי, מוטב ש..."],[14820,17530,"נלחץ את הידיים הנכונות."],[17580,19850,"נשבור את הלא נכונות."],[19900,22090,"אני חושב שיש לנו הבנה."],[24100,26690,"אנחנו לא מבקשים, אנחנו לוקחים."],[26740,29450,"וכשמישהו שוכח את מקומו,"],[29500,33290,"יש לי איש לזה, הבעיה נפתרה."],[33340,34370,"נעים להכיר אותך."],[34420,36810,"אשתי היא המוח מאחורי הקסם."],[36860,38490,"היא מחזיקה אותי יחד."],[38540,41410,"זה מה שהופך אותה למסוכנת מכולם."],[41460,43810,"בשנייה שתאבד בי אמון,"],[43860,47650,"המשפחה הזו תהפוך לאבק."],[47700,50650,"מקווה שתבין את זה."],[50700,53810,"אז אתה איתנו או נגדנו?"],[53860,60960,"אני משתף אותך בטבע שלי,"],[61340,66050,"כי כוח הוא דבר רעבתני."],[66100,69890,"ותמיד יש איזה חלאה שמחפש את הכתר."],[69940,73730,"מה זה... מה קורה פה ב\"מובלנד\"?"],[73780,80880,"כשקונרד מתחיל, אני מתכוון באמת מתחיל,"],[84260,88490,"אתה תתחרט."],[88540,92920,"סדרה חדשה, ב-30 במרץ ב-Paramount+."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"מובלנד","y":2025,"k":"tv","e":1,"f":2,"ts":1795203924}