{"c":[[1990,4240,"יש קולגה בעבודה שמתנכלים לו."],[4290,5340,"מה אתה הולך לעשות בנידון?"],[5390,6670,"כן."],[7680,10690,"גם אם זה היו\"ר, אני אצוד אותם ואהרוג אותם."],[10740,12350,"סוק-הואן."],[12400,15060,"אה, אתה יודע למה אתה לא מצליח?"],[16239,19540,"שלום, מי אתה?"],[27680,29320,"מה זה?"],[29420,32310,"לא היית בקשר כבר שלושה ימים?"],[33740,35590,"מישהו נחטף."],[39560,41830,"הממזרים האלה, קחו אותם מכאן."],[41880,42870,"כן."],[42920,44350,"כן."],[50580,52370,"זה סוג של מכונת זמן?"],[52420,55300,"אבל מה נסגר עם השיער שלך?"],[58300,60220,"אז זה היית אתה."],[61790,66030,"מכיוון שסוק-הואן יחזור בקרוב, אני לא מודאג מהבחור הזה."],[67230,67530,"מה זה?"],[67570,69610,"זה לא דם?"],[69880,71290,"מיץ פטל שחור?"],[71340,74030,"אני מניח שהם שתו את זה והקיאו."],[74400,75850,"זמן."],[78300,83080,"אני צריך למצוא עבודה ולהרוויח מספיק כדי לשלוח אותם לבית ספר לעתיד."],[83240,84990,"תבחר."],[91340,92550,"כמעט מתתי."],[92600,93850,"וואו."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"부활남: 더 레드","y":2026,"k":"movie","f":2,"ts":1795366303}