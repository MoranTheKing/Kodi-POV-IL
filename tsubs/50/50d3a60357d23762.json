{"c":[[7340,9420,"המחיר נשאר אותו דבר."],[9500,12040,"בסדר, תביאי את זה בחזרה."],[35180,36410,"אוהבת אותך, אחותי."],[36460,37850,"את נראית טוב, אווה."],[37900,39130,"את נראית טוב יותר."],[39180,40010,"את רוצה להחזיק אותה?"],[40060,41560,"איפה אבא?"],[43820,45530,"אל תתני לו להגיע אלייך."],[45580,47240,"אני לא נותנת."],[50780,51930,"אני רוצה לחזור."],[51980,55960,"אני יודעת כמה קשה היה לך בפנים."],[56940,58960,"עכשיו הדברים שונים."],[59900,62010,"אם הוא יחפש עלינו, אני גמורה."],[62060,64489,"אני לא יכולה לחזור, טום."],[64540,65770,"אני לא יכולה לחזור."],[65820,67250,"אני יודע."],[75420,78760,"חשודה, אישה לבנה, שנות ה-20 לחייה."],[78860,81690,"השוטרים הרגו אותו כדי להפליל אותי."],[81740,86760,"אם מישהו יגלה על זה, ובכן, אני לא צריכה להגיד לך מה יקרה."],[87900,89690,"הם לא מתכוונים לעצור."],[89740,91400,"מה עשית?"],[98140,100840,"יש סיכוי כלשהו שלא תהרוג אותי?"],[105980,107640,"סיימתי לברוח."],[118380,120600,"את לא יכולה פשוט ללכת."],[127020,128840,"זה החלק הקשה."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"עדה לרצח","y":2026,"k":"movie","f":2,"ts":1795370435}