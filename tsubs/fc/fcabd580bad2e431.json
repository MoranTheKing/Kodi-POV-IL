{"c":[[2750,4290,"דברים כאלה לא קורים פה כל יום."],[8000,9290,"אני לא יכול להרשות לעצמי שני חבר'ה"],[9290,12290,"שנראים כאילו הם אוכלים סטרואידים לארוחת בוקר..."],[12880,15420,"להפוך לי את האי לביירות!"],[15540,17000,"בלש, זה ממש..."],[17040,17880,"לא לעניין."],[17880,18790,"אתה עושה לנו גזלייטינג?"],[18880,21710,"תסביר לי למה היאקוזה רוצים אותך מת?"],[24790,25620,"אתה צריך לשאול אותם."],[25670,27250,"יאקוזה? זה מי שזה היה?"],[30540,31500,"פוצצת לי את האוטו."],[31580,34290,"פוצצתי להם את האוטו והוא נחת על שלך."],[35040,35920,"וואו!"],[36920,38250,"הם הרגע פוצצו לך את האוטו."],[40920,42000,"אתה רק מחפש צרות."],[42040,43040,"זה מה שאתה עושה!"],[43120,44420,"זה מה שאני עושה, כי אני שוטר."],[44500,45330,"פה אתה ממש לא!"],[46380,48040,"אבא שלנו נרצח."],[49120,50000,"זה היה פגע וברח."],[50080,50790,"אני לא חושב."],[51670,52540,"וואו!"],[52620,53290,"הם ניסו להרוג אותי."],[53790,54540,"קרב חרבות."],[64170,65290,"טוב, זה הולך להיות כיף."],[65379,66080,"כן, אני בטירוף."],[67170,68380,"אנחנו חייבים לגלות מי הרג אותו."],[71170,73420,"אני מבטיח שתעוררו דוב..."],[74580,76250,"שלא ממש בא לו להתעורר."],[77290,78920,"תקשיבו לי טוב כשאני אומר לכם..."],[80540,81290,"שאני הדוב הזה."],[91420,92830,"נינג'ות על אופנועים!"],[93170,94540,"פחות דיבורים, יותר יריות."],[96620,97210,"השמנת."],[99290,100000,"הזדקנת."],[109750,110920,"אז, אה..."],[111000,112920,"אתם רודפים אחרי רוצחים במיניוואן."],[113250,114790,"כן, הוא פוצץ לי את האוטו השני."],[114880,116420,"-זה לא מה שקרה. -זה לא מפתיע אותי בכלל."],[116500,117170,"זה בדיוק מה שקרה."],[117250,117960,"לא, זה לא."],[120170,121290,"אוי, שיט!"],[121380,122290,"תפוס אותו, אחי!"],[124420,125380,"אמא'לה!"],[125670,127420,"למה האוטו שלך לא נוסע מהר יותר?!"],[136040,137120,"אוקיי. מתפצלים."],[137170,139670,"אתם נראים כמו \"דה רוק\" שעשה סקס עם עצמו והוליד תאומים."],[140460,140880,"אהה!"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"צוות ההרס","y":2026,"k":"movie","f":2,"ts":1795293025}