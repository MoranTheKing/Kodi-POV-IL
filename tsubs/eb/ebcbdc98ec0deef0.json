{"c":[[15540,18170,"מי אתה, אלכס? אה, אני יודע מי אתה."],[18220,22050,"החוקר הראשי בתיק גארי סניצ'י."],[22100,25050,"ילד הפלא של משטרת המטרו."],[25100,29000,"אתה יכול לקרוא לי הבלש אלכס קרוס."],[39340,42410,"אנחנו יודעים שזה רד."],[42460,44570,"אתה לא תקבל ממני הודאה."],[44620,45810,"אתה לא בתוך הראש שלי."],[45860,48920,"אה, אני בהחלט חי שם בחינם."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"קרוס","y":2024,"k":"tv","e":1,"f":2,"ts":1795555603}