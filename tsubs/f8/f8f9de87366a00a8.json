{"c":[[2700,4200,"בלב ההיילנדס הסקוטיים,"],[5640,7940,"נמצאת טירה שבה מתגוררים הנאמנים."],[9410,12450,"המטרה שלהם: לזכות ברבע מיליון דולר."],[13610,14880,"אבל מסתתרים ביניהם..."],[16880,18480,"שלושה בוגדים."],[20090,21290,"מרגש, לא?"],[27060,27830,"תצטרכו את החוזק של אריה"],[28560,30000,"ואת הערמומיות של שועל."],[34130,34730,"אולי אתם מכירים אותי"],[34730,35200,"מהרווק."],[35200,36400,"אני מהישרדות."],[36400,37600,"האח הגדול: אולסטארס."],[37600,38520,"מתחת לסיפון."],[40170,41270,"אני יודע שאם הייתי בוגד עכשיו,"],[41270,42640,"הייתי מתפרק לגמרי."],[42640,44180,"את הולכת להתעמת איתה."],[44180,45780,"כשאת אומרת את השם שלה כל היום."],[45910,48680,"מותק, אני מחפשת כל תירוץ כדי להיפטר ממך!"],[49050,49720,"בום!"],[54690,56720,"אני חושבת שאת בוגדת. אני חושב שאתה בוגד."],[56720,57460,"סמכתי עליך."],[59790,60960,"אני אומרת לכם, או שתדיחו אותי או שתחסלו אותי."],[60960,61690,"סיימתי עם זה."],[62830,64700,"תסגרו את הארונות."],[67970,68730,"במשחק הזה,"],[68730,70740,"האדם שיושב לידכם"],[70740,74570,"יכול לחייך ולחייך, ולהיות נבל."],[75280,76480,"אני לא הייתי בוחרת את התלבושת הזו,"],[76480,78550,"אז אני לא חושבת שאני סומכת על השיקול דעת שלך."],[78550,79910,"בואו נדבר על זה!"],[81510,82720,"אני יכול לתמרן אותם."],[83720,84750,"אתה חושב שאני בוגדת?"],[85750,86990,"המשחק התחיל."],[89220,91120,"קדימה! קדימה!"],[94240,95460,"וו!"],[96660,98200,"יש בוגדים ביניכם."],[98500,99600,"חושבים שאתם יודעים מי הם?"],[102940,103970,"אז אל תסמכו על אף אחד."],[104640,106370,"וחשבתם ש\"עקרות בית אמיתיות מבוורלי הילס\""],[106370,107010,"זה גרוע."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"הבוגדים","y":2023,"k":"tv","e":1,"f":2,"ts":1795380554}