{"c":[[2200,3200,"אוואטר."],[3200,5300,"זה סתם משחק בבובות, נכון?"],[6300,9200,"בבית הספר הזה, ה\"אוואטר\" הוא הכל."],[10200,12100,"זה לא סתם משחק, כל בית הספר"],[12100,13700,"נשלט על ידי זה."],[14700,16700,"הברכה של הבוקר היא \"בוקר טוב\"."],[18600,21600,"עד לרמה שזה נראה בדיוק כמו המציאות."],[22500,25100,"קאווה-סאן, את זאת את, נכון?"],[25100,27500,"זה היה משחק בית ספר, נכון?"],[27500,30200,"את סטוקרית, את יודעת."],[30200,32900,"העיניים שלך... זה בגלל האוואטר ההוא."],[32900,36400,"קאווה-סאן, את היחידה שיכולה לגרור אותה לזה."],[36400,37600,"תני לי 40,000 ין."],[38100,40500,"למה את צריכה כל כך הרבה כסף?"],[40500,42000,"בשביל המשחק הזה שקוראים לו \"אוואטר\"?"],[42000,43400,"זה לא משחק!"],[43400,44800,"האוואטר הוא הדבר הכי חשוב לי."],[47300,48800,"הוא חלק ממני."],[66700,68500,"איפה הברכות שלכם?"],[70100,71600,"אני לא מבינה מה אתם אומרים."],[71600,72900,"מעכשיו, זו התקופה שלך."],[72900,74700,"מיצ'יקו-סאמה."],[75700,77200,"האוואטר המפואר של מיצ'יקו-סאמה..."],[77200,78900,"זה מועדון אוואטר, נכון?"],[78900,80300,"נראה שאתם משחקים בזה ברצינות."],[80300,83000,"אני אדאג שכל חברי המועדון שלכם"],[83000,90000,"ייזרקו החוצה."],[90100,92200,"מי שמתנגד לי, זה מה שקורה לו."],[93800,95500,"אני..."],[95500,97600,"האוואטר שלך חסר ערך."],[97600,98500,"אז..."],[98500,99700,"אני לא צריכה אותו יותר."],[101300,102300,"זה..."],[102300,104500,"זו לא מיצ'יקו."],[104500,107200,"זו לא מיצ'יקו!"],[108200,109900,"אני אעשה אותך יפה"],[109900,111700,"מיד."],[111700,118700,"רק תחכי."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"アバター","y":2011,"ts":1795206284}