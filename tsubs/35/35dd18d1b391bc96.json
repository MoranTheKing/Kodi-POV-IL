{"c":[[1840,4370,"מעצר אזרחי!"],[4370,5170,"הא!"],[5170,6430,"הא, הא הא!"],[6430,8500,"אז הצרות באמת התחילו."],[9760,11500,"זה לי רייבון."],[11500,12340,"לי רייבון."],[12340,14510,"הוא כותב לכל עיתון"],[14510,16020,"שמוכן לזרום עם תיאוריות הקונספירציה שלו."],[16020,17490,"קראת את העיתון שלי?"],[17490,19140,"זה רכילות ופושעים."],[19140,21160,"הוא קצת מחוספס."],[21160,22600,"אבא, אתה בסדר?"],[22600,23400,"כן."],[23400,24270,"כן, לא, אני בסדר."],[24270,25520,"רוצה לנהוג?"],[26320,29380,"מדי פעם, הוא מסתבך מעל הראש."],[29380,30930,"כאב הוא זמני בלבד."],[30930,31730,"תוציאו אותי מכאן!"],[32530,33590,"עד שהוא כבר לא."],[35260,37590,"זה נראה טוב."],[37590,38390,"כן."],[42810,45480,"אם אתם קוראים את זה, כנראה שאני מת."],[48120,51450,"מאחורי כל הון גדול מסתתר פשע גדול."],[53170,54410,"המשפחה של המת?"],[54410,56400,"הוא חלק מהאילומינטי של אוקלהומה."],[56400,59170,"אילומינטי?"],[59170,60650,"אתה שובב."],[60650,63970,"מה שגיליתי זה מטורף –"],[63970,71330,"מנהרות נסתרות, דברים מוזרים, אמנות גנובה."],[71330,73260,"אתה מחטט במקום הלא נכון."],[73260,76080,"אה, אני מחטט בדיוק במקום הנכון, וזה מסריח."],[77480,79750,"מה הביא אותך לסוניאטה היום?"],[79750,81830,"מישהו מנסה להרוג אותי."],[81830,83090,"אה."],[86720,88410,"בשבילך הכל משחק."],[89200,90920,"איימו על המשפחה שלי."],[90920,91720,"אבא!"],[91720,93490,"זה לא משחק."],[98750,101360,"העיר הזאת עומדת להתפוצ..."],[104460,105440,"תחביא את זה, טוב?"],[105440,106810,"בן אדם, יש על זה דם..."],[106810,109630,"זה כסף של דמים?"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"כל האמת","y":2025,"k":"tv","e":1,"f":2,"ts":1795777113}