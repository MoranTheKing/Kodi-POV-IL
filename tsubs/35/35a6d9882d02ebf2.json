{"c":[[43700,45090,"יש פה סיפור רפאים ישן על אישה בשם מרי שו."],[45140,46850,"מרי שו."],[46900,50080,"פיתום שאיבדה את קולה."],[51460,55000,"כשהייתי ילד, ילד קטן, מישהו נעלם."],[55260,57170,"הייתה רק חשודה אחת, מרי."],[61260,62850,"היא נרצחה."],[62900,65040,"האנשים כרתו את לשונה."],[65940,70200,"ומאז העיירה הזאת מוכת מוות."],[70580,73600,"משפחות נמצאו ללא לשונן."],[78740,81090,"היא נקברה עם אוסף הבובות שלה."],[81140,83450,"הילדים, כך היא קראה להם."],[84660,86610,"מישהו חפר אותן החוצה."],[86660,88480,"כל המאה שלהן."],[90340,91570,"הן חזרו."],[91620,93680,"הן לא נשארו מתות."],[102180,103600,"היא כאן."],[108220,109690,"מה קורה פה?"],[109740,112570,"היזהרו ממבטה של מרי שו."],[112620,115410,"לא היו לה ילדים, רק בובות."],[115460,117360,"השמידו את הבובות!"],[117460,119320,"ואם תראו אותה,"],[119620,123120,"ואם תראו אותה, אל תצרחו."],[126740,129960,"או שהיא תתלוש לכם את הלשון."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"דממת המוות","y":2007,"k":"movie","f":2,"ts":1795634976}