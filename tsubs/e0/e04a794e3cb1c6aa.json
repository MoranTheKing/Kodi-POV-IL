{"c":[[2290,5250,"רוצה לשמוע סוד?"],[8550,11260,"אנשים מדברים על רובין הוד."],[11260,13720,"מספרים את הסיפורים שלו."],[13720,16730,"הכל שקרים."],[17680,19350,"הוא לא היה גיבור."],[19350,22360,"הוא היה שודד רצחני."],[22690,25190,"היינו מפלצות."],[25190,28190,"אני פורע החוק. לא!"],[30070,33070,"רובין הוד."],[52090,54510,"אני חייב לך התנצלות."],[54510,56350,"התחננת שאתן לך למות."],[58980,61980,"איך קוראים לך?"],[70780,72910,"תוכל להכין לי?"],[72910,75910,"אני אכין לך קשת."],[77330,80330,"בסדר."],[81410,84250,"מה קרה לה?"],[84250,87250,"דברים נוראים."],[91090,94090,"אני עוזר למי שמגיע לאי הזה."],[95180,97930,"ואנשים משנים את דרכם."],[97930,99180,"הרגתי כל כך הרבה."],[99180,102190,"אני לא יכול לספור."],[103690,106690,"זו קללה."],[111240,115450,"יש שם אנשים רעים. אני חושש שחובות הדם שלנו ירדפו אותה."],[124750,126790,"אני אשמור עלייך."],[126790,127840,"אני אשמור עלייך."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"מותו של רובין הוד","y":2026,"k":"movie","f":2,"ts":1795632380}