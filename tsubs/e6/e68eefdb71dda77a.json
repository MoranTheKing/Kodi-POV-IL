{"c":[[8039,10830,"כשהייתי ילד, הייתה לי תחושה כזאת."],[14210,15790,"קראתי לזה \"זמזום לבן\"."],[22920,24920,"ואז הכל היה הופך ללבן."],[29880,31620,"כאילו אני לא אני באותו רגע."],[39170,40880,"הזמזום הלבן הזה היה נשפך לי על המוח"],[40960,42830,"כמו נהר של אש מזוינת."],[44790,47460,"אותה תחושה הייתה לי כשהתחלתי לשחק פוטבול."],[54080,54920,"זה היה רועש."],[55920,57670,"והכל נהיה לבן."],[65000,66330,"זה מה שזה אומר להשתגע?"],[93500,94620,"נחת!"],[95380,99000,"זו מלחמה! זו מלחמה אמיתית!"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"The Mosquito Bowl","y":2026,"k":"movie","f":2,"ts":1795793836}