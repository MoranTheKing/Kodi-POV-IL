{"c":[[20140,21850,"המונאי שלך כל כך טעים."],[21900,23930,"גם בלי מילוי, הוא טעים."],[23980,25640,"של אחותך."],[26260,28040,"אני נכנס, בסדר?"],[36300,39480,"מה? זה יותר טעים מה ש... מ..."],[41260,43510,"אני גם אשיג אותך, ג'לו."],[45020,45730,"אני מצטער."],[45780,47010,"נתנו לך רק חודש אחד."],[47060,47370,"[מוזיקה]"],[47420,50160,"אם לא, המאפייה שלכם תיסגר."],[50420,51170,"ממ, טעים."],[51220,52250,"אתה סוחב הרבה, אה?"],[52300,53930,"בוא, אני אקפיץ אותך."],[53980,56130,"למה אתה לא יכול פשוט להגיד למונינה?"],[56180,57490,"אני לא רוצה שהיא תדאג עוד."],[57540,57930,"[מוזיקה]"],[57980,59530,"אמא שלנו מתה."],[59580,63850,"הבטחתי לה שאדאג לאחותי היטב, אז זאת הבעיה שלי."],[63900,71000,"אני מעדיף לראות אותנו..."],[78780,79730,"אחותי היא גבר."],[79780,82170,"לא משנה מה תגיד, אני לא אאמין לך"],[82220,84250,"כי אני לא אפחד מאחותך."],[84300,87160,"אני לא מסכים לתת לך אותה."],[87620,88960,"בשביל"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Monay","y":2026,"k":"movie","f":2,"ts":1795371620}