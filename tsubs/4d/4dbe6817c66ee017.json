{"c":[[2260,4040,"אנשים הם ורדים."],[4260,6400,"משפחות הן שיחי ורדים."],[6900,9090,"שיחי ורדים צריכים גזם."],[14220,17480,"כולנו ירשנו המון כסף אחרי שאמא מתה."],[17980,19640,"כולנו עצלנים."],[26140,29520,"כולנו, חוץ מאחי ג'ק."],[34260,35870,"ג'ק הוא אחר."],[37900,39680,"מסכן ג'ק."],[41940,43610,"את אוהבת את אחי, אנני?"],[43660,45150,"אני אוהבת."],[45820,46530,"הוא מאחר."],[46580,48050,"כי הוא היה עם הבחורה ההיא,"],[48100,50010,"ואני פשוט לא יכולה לשאת את המחשבה הזו."],[50060,52640,"והבגדים שהיא לובשת הם..."],[56420,59030,"אוי, בסדר. ברוכה הבאה למשפחה."],[73780,75090,"אני במחזור, ג'ק."],[75140,76980,"אתה יכול להאמין?"],[86300,89090,"אהבה היא לא רק משהו שיכול לחרמן אותך,"],[89140,92000,"אלא גם משהו שיכול לשחרר אותך."],[93100,94410,"מאיתנו."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Rosebush Pruning","y":2026,"k":"movie","f":2,"ts":1795687955}