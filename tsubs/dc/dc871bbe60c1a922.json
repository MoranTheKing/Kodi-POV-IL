{"c":[[11510,13850,"אל תקשיבי לשטויות"],[13930,15310,"שיוצאות לאנשים מהפה."],[15390,17730,"אנחנו על סף גדולות."],[19600,21230,"מרגו: איך נתתי לזה לקרות?"],[26150,27690,"מרגו, למה את פה?"],[27780,28820,"מארק: את יכולה ללכת לכל מקום."],[28900,29570,"כמו להרווארד?"],[29910,31280,"כן, כמו להרווארד."],[31740,32200,"אה."],[33870,35410,"אז, איך הלימודים?"],[38040,39460,"אלוהים אדירים."],[40210,41330,"שאיין: היית אמורה להיות מישהי."],[41420,42420,"מי הייתי אמורה להיות?"],[42500,43630,"מה שרק רצית!"],[44130,45630,"מרגו: אבל בחרת להשאיר אותי."],[46510,47590,"הרסתי לך את החיים."],[48800,51430,"הרסת לי את החיים בצורה יפהפייה."],[52680,53800,"מרגו: אני צריכה להרוויח כסף."],[53890,55600,"אני מוכנה לכל עבודה שקיימת."],[55680,56850,"אפילו לחפור תעלות."],[57390,59060,"נראה שכבר חפרת לעצמך אחת."],[60940,64230,"מרגו: כדי להכניס כסף לילד שלי,"],[64310,66650,"התחלתי לעבוד באינטרנט."],[68320,70900,"לתמונות הראשונות, נעשה ממך בחורה מפחידה."],[72450,73610,"אני אחשוב על זה."],[74160,75280,"זו לא את."],[75370,76830,"טוב, אמא שלי עבדה ב\"הוטרס\","],[76910,78160,"ואבא שלי היה מתאבק מקצועי."],[78250,79450,"ג'ינקס, ג'ינקס, ג'ינקס!"],[79540,80450,"תגיד לי מה זה \"אני\"."],[82120,83040,"יש לך מעריצים?"],[83120,85040,"זה אתר פופולרי."],[88880,90880,"אני מפקפק בכישורים ההוריים של מרגו."],[91260,92680,"אין לך כסף, אין לך תוכנית..."],[93180,95050,"ואת עושה סימולציות מיניות עם חייזרים."],[95140,96430,"אני החייזר!"],[97760,99600,"פגשתי הרבה אנשים בחיים"],[99680,101020,"שצריכים להתנצל."],[102440,103940,"את לא תהיי אחת מהם."],[106730,107980,"יש לי רעיונות גדולים."],[108940,110480,"ג'ינקס: אני שמח להדריך אותך,"],[110570,113570,"אבל ברגע שתתחילי לעשות עוד מה... אה..."],[113660,114530,"נו, את יודעת, ה... אה..."],[114610,115990,"- הדברים... הסקסיים... - אוקיי, אבא."],[116070,118030,"כן, כן. אני פשוט אקח את התינוק איתי."],[118120,118950,"אוקיי."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"Margo's Got Money Troubles","y":2026,"k":"tv","e":1,"f":2,"ts":1795300897}