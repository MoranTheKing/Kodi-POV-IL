{"c":[[540,1710,"אה!"],[1710,2840,"האימונים מתחילים עכשיו."],[7460,8590,"אוקיי, תקשיבו."],[8590,10010,"בואו נעשה את מה שבאנו לעשות."],[10470,11800,"דוד ג'ייק מגיע לעיר."],[11800,12890,"חשבתי שהוא בשירות פעיל."],[14930,15770,"נפגענו, אנחנו מתרסקים."],[16100,18680,"הוא קצת נפצע, אז חשבתי שזה יכול להיות נחמד"],[18680,19940,"אם הוא יישאר אצלנו בקיץ."],[19940,20640,"כן."],[20640,21650,"מה, אתה לא רוצה שהוא יבוא?"],[21650,23060,"אני פשוט לא רוצה שהוא יראה שאני..."],[23690,25020,"שאני מוזר."],[27440,28490,"היי, תן כיף, חבר."],[28490,29860,"תעזור לדוד ג'ייק עם התיק."],[30160,30700,"אה..."],[31780,32320,"לא."],[32320,33320,"הוא כבד."],[34990,35780,"דוד ג'ייק?"],[35780,36620,"אני חייב לשאול אותך משהו."],[36740,38830,"יש ילדים בבית הספר שתמיד מציקים לי"],[38830,39790,"ומתנכלים לי."],[40410,42460,"בבקשה, תלמד אותי להילחם."],[42460,44290,"להילחם באנשים זה לא הפתרון."],[44290,45880,"מארק, באמת אין לי זמן לזה."],[45880,48210,"דוק, מה צריך כדי לחזור לצוות שלי?"],[48210,48970,"זמן."],[50670,51880,"מי זה בא, מי זה בא,"],[51880,53140,"הנה מארקי הקטן."],[53140,54390,"פשוט תעזבו אותי."],[56140,56970,"יש פה בעיה?"],[60890,62100,"האימונים מתחילים עכשיו."],[62100,62730,"אמצע הלילה!"],[63100,63690,"אה!"],[63690,65310,"שיעור ראשון: אף אחד לא יכבד אותך"],[65310,66400,"עד שלא תכבד את עצמך."],[69690,71610,"מה זה \"קונסטיפיישן ווריור קיד\"?"],[71610,72990,"כתבתי את זה ביד שמאל."],[72990,73570,"טוב, להתרכז."],[76120,76830,"ברצינות?"],[76830,77950,"קדימה, חבר חדש."],[77950,78450,"צא לשם."],[84500,85170,"הויה!"],[85170,86000,"אני רוצה לשמוע אותך אומר את זה."],[86000,87090,"הויה."],[90920,93180,"אני יודע שאתה רוצה לעזור, אבל אני לא לוחם."],[93180,94640,"למה אתה עוזר לי?"],[94640,95970,"כי אנחנו דומים יותר ממה שאתה חושב."],[96640,99220,"אנשים יכולים להשתנות."],[99220,100390,"לוחמים לא נולדים,"],[100390,101430,"הם נוצרים."],[102100,103600,"אני אהיה פה איתך."],[111360,113280,"ילד לוחם פועל להשיג את המטרות שלו."],[113820,116620,"הוא מפתח חוסן מנטלי וגם פיזי."],[124500,125580,"הויה!"],[129880,131840,"דוד ג'ייק, רציתי לשאול אותך משהו."],[131840,133760,"זה בנוגע לשינויים שעוברים על הגוף שלך?"],[133760,135220,"כי אני לא יודע אם..."],[135720,137050,"אני לא יודע אם אמא שלך תרצה... -אייכס."],[137050,138680,"דוחה, וזה לא."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"Way of the Warrior Kid","y":2026,"k":"movie","f":2,"ts":1795696944}