{"c":[[1790,2540,"היי, פרנק."],[5090,6170,"מה קורה, אח שלי?"],[14430,15180,"דבר אליי."],[22810,24230,"תגיד לי מה קורה כאן."],[30530,31610,"אבא..."],[32780,34620,"אתה חושב שאלוהים יסלח לנו על מה שעשינו?"],[42580,43590,"אני לא בטוח לגבי עצמי."],[45960,46550,"אבל אתה?"],[50880,52380,"לך אין סיכוי מזוין."],[68070,69440,"אבא!"],[73780,74780,"זה כל מה שיש לך?"],[77160,78200,"זה כל מה שיש לך?!"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"המעניש: חיסול אחרון","y":2026,"k":"movie","f":2,"ts":1795264416}