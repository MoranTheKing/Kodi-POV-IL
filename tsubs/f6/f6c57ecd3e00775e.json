{"c":[[4260,5810,"כמה זמן אתה כבאי?"],[5860,7450,"מאז היום שנולדתי."],[7500,9690,"גיבורים ביום-יום, נלחמים באש יחד."],[9740,10770,"זה הופך אתכם למשפחה."],[10820,13960,"במשפחה הזו, כולם חוזרים הביתה."],[16900,19010,"מצילים את חייהם של אחרים,"],[19060,20570,"הוא נפצע, תכניסו אותו!"],[20620,21050,"תכניסו אותו פנימה!"],[21100,22690,"ונאחזים בחיים שלהם."],[22740,26450,"מה אם נחיה כל יום כאילו הוא האחרון?"],[26500,28930,"מהמפיק בפועל דיק וולף."],[28980,30210,"קדימה, לזוז!"],[30260,33930,"מגיעה הסדרה שהמבקרים מכנים \"מרתקת\" ו\"חובה\"."],[33980,35330,"נמאס לי מהבחור שלך."],[35380,36290,"לא אכפת לי ממה נמאס לך."],[36340,39090,"עם אקשן קצבי,"],[39140,40770,"קדימה, רק קדימה!"],[40820,42330,"כולם לעבוד כצוות!"],[42380,43010,"תעשו את זה מהר!"],[43060,47210,"קאסט יפהפה וסקסי,"],[47260,51210,"הדרמה החדשה והטובה ביותר בטלוויזיה."],[51260,52410,"אתה עדיין פה? תלך הביתה."],[52460,54690,"מפקד, אני בבית."],[54740,57170,"כבאי שיקגו."],[57220,59920,"צפו ב-DVD."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"כבאי שיקגו","y":2012,"k":"tv","e":1,"f":2,"ts":1795223792}