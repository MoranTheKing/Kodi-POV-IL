{"c":[[0,1540,"חבר'ה, תקשיבו לי טוב"],[1540,3710,"כי אני מסבירה את זה רק פעם אחת."],[3710,5460,"יש פה כלבים משוטטים בכל מקום."],[5460,7420,"אל תאכילו אותם."],[7420,8010,"בשום אופן."],[8010,8880,"ראיתי את הגברת-"],[8880,9590,"בשום אופן."],[9590,10260,"אבל מה אם הם-"],[10260,11090,"בשום אופן."],[12890,13850,"בשום אופן!"],[15470,16350,"בוקר טוב לכולם."],[16350,19230,"עוד יום יפהפה בדרום יוון."],[19230,20890,"אז תסתכלו על החבר שלצדכם"],[20890,23440,"ותנו לו יד."],[24020,26780,"הזרועות שלהם נשרפו לגמרי בשמש."],[26780,28070,"למה שלא תשבי-?"],[28900,29570,"אוי."],[31410,33280,"אני הפנים של החפירה הארכיאולוגית הזאת."],[33280,35660,"אבל אתם הלב הפועם שלה."],[35660,37490,"קיבלתי החלטה."],[37490,38580,"אני פורשת, אליס."],[38580,40250,"זו לא הפעם הראשונה שאת"],[40250,41790,"אומרת שאת פורשת."],[41790,42960,"אוקיי!"],[43290,45000,"אשאר עוד שנה אחת!"],[48470,49510,"לעזאזל."],[50170,51180,"לא מצאו דבר כזה"],[51180,52720,"כבר מאות שנים."],[53390,54180,"אנחנו חייבים לספר לנוויל."],[54550,55260,"לא."],[55600,57310,"הוא ייקח את הקרדיט כמו תמיד."],[57810,58980,"אבל אם נחפור את זה בעצמנו,"],[59730,60810,"את תקבלי את הקרדיט."],[60810,62150,"זה יהיה גרוע יותר מווטרגייט."],[63060,63600,"נכון."],[63600,65310,"בבקשה תגידי לי שאת יודעת מה זה ווטרגייט."],[65310,66190,"תרגעי."],[66190,66730,"קראתי על זה."],[66730,67480,"זה לא ספר."],[67480,68400,"זה היה פשע."],[68940,70150,"אני רוצה להשתלט על החפירה הזאת"],[70150,71610,"כבר המון זמן."],[71860,73160,"זו כנראה ההזדמנות היחידה שלנו."],[73910,74740,"את בפנים?"],[74910,76330,"אנחנו בזה ביחד,"],[76330,77490,"כמו שלושת המוסקטרים."],[78370,79540,"פלוס עוד אחד."],[82330,83120,"זה לא חוקי."],[83880,85380,"אתם חייבים לדווח על הממצא הזה."],[87420,88130,"ההונאה,"],[88130,88960,"התככים."],[91510,92510,"האמת? זה די לוהט."],[97180,98060,"באמת לא ידעתי מי אני."],[98060,98810,"אנחנו חייבים לזוז."],[99680,102230,"ועכשיו אני מתחילה להבין את זה."],[102940,104520,"אלו תמונות שלנו?"],[104520,106270,"מישהו עקב אחרינו!"],[107770,108480,"אה!"],[108820,111030,"אוקיי, ואני