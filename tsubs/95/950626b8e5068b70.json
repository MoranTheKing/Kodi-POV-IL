{"c":[[2000,3500,"את יודעת שאני הולכת לארמון היום, נכון?"],[3500,5000,"יורשת \"קאסל גרופ\" הוזמנה"],[5000,6900,"לסעודת יום ההולדת המלכותית של הוד מעלתו."],[7000,9200,"היא פשוטה והיא נולדה מחוץ לנישואין?"],[9200,10400,"היא חסרה הרבה דברים,"],[10400,12000,"כמו עידון, נימוסים, ושפיות."],[12000,13600,"לחיים."],[13600,15000,"הוד מעלתו, הנסיך הגדול אן, הגיע."],[15000,16400,"את מאפילה על הוד מעלתו."],[16400,18100,"הוד מעלתו הוא רק בן שמונה."],[18100,19600,"הוא צעיר מדי כדי לנהל את ענייני המדינה."],[19600,21200,"העוצרות שלי היא בלתי נמנעת."],[21200,24500,"תינשא לאישה שבחרתי ותפגין את תמיכתך במלך."],[24500,26000,"גברת סונג הוי-ג'ו ביקשה שוב ראיון."],[26000,27400,"איך את בכלל מעיזה לחשוב"],[27400,28700,"על להתחתן עם הנסיך הגדול אן?"],[28700,29400,"למה לא?"],[29400,30800,"בקשתך לראיון סורבה."],[30800,31500,"סורבה."],[31500,32800,"הפעם היא כתבה שהיא \"בת טיפוחייך\"."],[32800,33400,"בת טיפוחיי?"],[33400,34800,"הצב השחור של הצפון!"],[34800,36500,"אנחנו נפגשים שוב."],[36500,38300,"למה כל כך נואשת לפגוש אותי?"],[38300,40000,"אני מחפשת להתקדם בחברה."],[40000,41200,"סונג הוי-ג'ו?"],[41200,42300,"התגעגעתי אליך."],[42300,43500,"בדקת אותי?"],[43500,44200,"כן."],[44200,46000,"בסך הכל שם ותואר חסר משמעות?"],[46000,47300,"את רוצה להתחתן?"],[47300,48400,"הוד מעלתו, היא פשוטה."],[48400,49500,"היא גם נולדה מחוץ לנישואין."],[49500,50700,"אז הוא יודע איך לשחק את המשחק?"],[50700,51500,"את מפחדת?"],[51500,53500,"אתה תאשר את הנישואין שלי."],[53500,54500,"עלינו לחקור."],[54500,55500,"תחייכי! תמשיכי לחייך!"],[55500,56900,"רוצה ללכת איתי למקום כלשהו?"],[56900,57900,"בואי נגביר את הקצב קצת."],[57900,59500,"סבלנות היא מעלה כשאתה בציד."],[59500,61100,"היית צריכה לשמור על כבודך המלכותי."],[61100,62400,"הוד מעלתו!"],[62400,64200,"השמועות על הקשר שלך עם סונג הוי-ג'ו נכונות?"],[64200,66000,"תתרחקו מהוד מעלתו!"],[66000,66700,"מה לא בסדר בזה?"],[66700,68500,"מה את חושבת שאת עושה?"],[68500,69500,"ככה מגינים על מישהו."],[69500,70500,"את התקווה היחידה שלי."],[70500,72300,"למה בדיוק את רוצה להתחתן עם הנסיך הגדול?"],[72300,73500,"מעמד חברתי זה הדבר היחיד שחשוב לך?"],[73500,74800,"אז תינשא לי במקום."],[74800,76000,"אני בסדר."],[76000,77500,"אני רגילה להילחם באנשים כאלה."],[77500,78500,"את בטוחה בעצמך?"],[78500,80000,"תתכונני להפוך לאשת הנסיך הגדול."],[80000,81200,"זו פקודת המלך."],[81200,82300,"מה אתה רוצה ממני?"],[82300,84300,"תעשה כל מה שצריך כדי להגן על הוד מעלתו."],[84300,85300,"איבדת את שפיותך?!"],[85300,86300,"גם אני אעשה משהו מטורף?"],[86300,87500,"אני רואה שמעולם לא למדת להתכופף."],[87500,88400,"אל תתכופפי."],[88400,90000,"ואל תוותרי."],[90000,91000,"את!"],[91000,92000,"זה הכל בשבילך."],[92000,94000,"רומן מרדני שמתנגד לשושלת"]],"s":"listen","m":"gemini-3.1-flash-lite","n":"כתר מושלם","y":2026,"k":"tv","e":1,"f":2,"ts":1795850567}