{"c":[[2220,4560,"אה? באת?"],[5180,8160,"וואו, ילדה."],[10260,13160,"צעירה ויפה, נכון?"],[14420,18250,"אני המנהיג של כת \"גן העדן הנצחי\"."],[18300,20610,"כולם כל כך מפחדים מהמוות."],[20660,23600,"אז אני אוכל אותם, כדי להציל אותם."],[24500,27010,"תחיו איתי לנצח."],[27060,29160,"בזמן אינסופי."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"קוטל השדים: מבצר האינסוף","y":2025,"k":"movie","f":2,"ts":1795559779}