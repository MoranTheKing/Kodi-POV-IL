{"c":[[2840,3710,"הגעת למוקד החירום."],[3840,4420,"מה מהות החירום"],[4420,5300,"שלך, בבקשה?"],[5800,7800,"אמרו לי להתקשר למספר הזה כדי לקבל עזרה."],[7970,8510,"אני אבודה!"],[8760,9550,"אני לא יודעת איך"],[9550,10970,"אחזור הביתה."],[11050,11590,"הכול בסדר."],[11590,12470,"עשית את הדבר הנכון."],[13600,14300,"איאן: החדשות הטובות הן"],[14390,15770,"שאת מופיעה לי על המסך."],[16059,17020,"קוראים לי איאן."],[17270,17770,"את יכולה להגיד לי מה שמך?"],[17770,18270,"שרה."],[18520,18810,"איאן: שרה."],[19180,20390,"מגי: אולי זה מאגס."],[20390,20940,"מגי: אני לא יודעת."],[21060,21690,"אמרת מאגס?"],[23690,24690,"את יכולה לחזור על זה שוב, בבקשה?"],[25320,26030,"מגי: - אני לא יודעת. -את יכולה לחזור על זה?"],[26230,26980,"מגי: אני לא יודעת."],[26980,28530,"מגי: אולי זה מאגס."],[33620,35370,"איאן: הבת שלי נעלמה לפני אחת-עשרה שנה."],[36740,37370,"איאן: מגי?"],[37950,39410,"מגי: אולי זה מאגס."],[42250,43170,"ג'נה: אני לא מפסיקה לחשוב"],[43170,44590,"ג'נה: על המשפחה המסכנה הזאת."],[49760,50880,"איאן: פספסתי אותה בדקות."],[53720,54890,"אתה... אתה בטוח, חבר?"],[54890,55390,"זו היא."],[55800,56600,"איאן,"],[56600,57600,"דבי: אתה צריך לשחרר."],[59770,60770,"מגי: השם שלי הוא מאג..."],[60770,61140,"מגי: אני לא יודעת,"],[61140,63100,"מגי: השם שלי הוא מגי. -אולי זה מאגס?"],[63520,64519,"זה הקול שלה."],[65230,65810,"הבלש פניה: איך אתה יודע?"],[68110,69230,"אם אכפת לך מאיתנו,"],[69440,70150,"הנרי: אתה לא הולך לספר"],[70150,71400,"הנרי: לאף אחד על זה, בשום אופן."],[72410,73160,"מה עם טביעות אצבע?"],[73360,74070,"לא מצאנו כלום."],[75120,75740,"איאן: מאיפה השגת את זה?"],[76080,77530,"יש לו אליבי מושלם."],[78080,80200,"דבי: יש בך רק מרירות."],[81040,82250,"וזעם."],[84290,85170,"איאן: מאגס!"],[87090,87630,"מאגס!"],[87630,88920,"תעזוב את הבת שלנו בשקט!"],[89840,90550,"איאן: מגי!"],[95300,97140,"דבי: איך אתה יכול להיות בטוח שזו היא?"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"Last Seen","y":2026,"k":"tv","e":1,"f":2,"ts":1795286258}