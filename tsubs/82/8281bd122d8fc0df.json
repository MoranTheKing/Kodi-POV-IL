{"c":[[6710,8170,"מיקי מאוס: זהו? כולם הלכו?"],[9080,9790,"מיקי מאוס: הו, בוי!"],[10290,12330,"מיקי מאוס: בואי, מיני. זה הרגע!"],[12330,15120,"מיני מאוס: בואו נאסוף את כולם. יולהו!"],[15580,16750,"מיקי מאוס: זמן לתמונה, חברים!"],[17080,18170,"טמפר: אוקיי!"],[18710,21380,"פיטר פן: קדימה, כולם. יוצאים לדרך!"],[23580,25460,"מואנה: אה! הא!"],[26500,27170,"פלאונדר: מים!"],[30540,31290,"פלורה: שיהיה ורוד."],[32710,34290,"מריוות'ר: הו! שיהיה כחול!"],[36880,38830,"פו הדב: אוי, אוי... עזרה!"],[38830,39920,"פו הדב: הו, מרגיז."],[39920,42420,"אנה: את חושבת שכל הנבלים יגיעו?"],[43420,44080,"אלזה: לא כולם."],[45750,47960,"קריין: חוגגים 100 שנים לדיסני עם..."],[53880,54880,"מיקי מאוס: גופי, להיזהר!"],[55290,56790,"גופי:"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"היו היה סטודיו","y":2023,"k":"movie","f":2,"ts":1795461605}