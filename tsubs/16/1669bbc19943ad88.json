{"c":[[300,2890,"נאנג, הבחורות האלה מנוסות, את צריכה ללמד אותן?"],[2940,6690,"הן מכירות את הגוף שלי טוב ממני."],[6740,9850,"באמת? אז את אומרת ש..."],[9900,11930,"אחותי, את מסקרנת אותי."],[11980,17160,"אם את כל כך סקרנית, למה שלא תנסי בעצמך?"],[18460,20690,"אני מריאן, חברה של ג'סה."],[20740,22490,"ג'סה לא אמרה לי שאת באה."],[22540,23090,"זה בסדר."],[23140,24860,"אז מה את רוצה?"],[30820,32490,"חבר'ה, זה נייט."],[32540,33330,"תיזהרי, אחותי."],[33380,35610,"שלא יעלה לך יותר מדי לראש."],[35660,37010,"את מחמיאה לו יותר מדי."],[37060,38840,"אגב, אני אייקו."],[39580,40930,"אפשר לדבר איתך רגע?"],[40980,41730,"רק לדבר?"],[41780,42430,"כן, רק לדבר."],[46220,48240,"אני נעלמת פתאום."],[52380,53410,"תיזהרי, אחותי."],[53460,54800,"למה?"],[55140,56290,"מה קורה פה?"],[56340,57370,"כלום."],[57420,60410,"נראה כאילו יש לכם סודות ממני."],[60460,67560,"אין לנו ברירה, פשוט השתלט עלינו החשק."],[69140,70240,"ג'ס"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Pansamantala","y":2026,"k":"movie","f":2,"ts":1795367534}