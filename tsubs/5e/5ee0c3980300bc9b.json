{"c":[[6420,9260,"הם המתנקשים הקטלניים ביותר בעולם."],[13860,20960,"זהותם היא סוד אפילו זה מזו."],[21540,23850,"איך זה עובד?"],[23900,27930,"הייתה לנו בעיה קטנה עם משימה ב\"האוס\", מחפשים כבר עבודה או משהו?"],[27980,29640,"אתם העבודה."],[30820,31930,"גם לנו היו כמה בעיות."],[31980,33330,"עשית משהו חדש?"],[33380,34690,"הוספתי אפונה."],[34740,36290,"אה, אפונה."],[36340,37370,"אני אוהב את אשתי,"],[37420,42370,"אבל יש זמנים שיש פער עצום בינינו,"],[42420,47530,"והוא פשוט מתמלא בכל מה שאנחנו לא אומרים זה לזו."],[47580,49450,"איך את חושבת שהיא למדה לירות ככה?"],[49500,51530,"זה נראה כמו הממשלה או משהו."],[51580,55210,"זוהית על ידי סוכן מתחרה."],[55260,56570,"איך אתה הולך לטפל בזה?"],[56620,57490,"אני הולך להשאיל את זה."],[57540,58850,"כן, כן."],[63820,65770,"בקיץ הקרוב, האהבה הופכת קטלנית."],[65820,67250,"יש לכם בעיה לא שגרתית, ג'אן."],[67300,69330,"ברור שאתה רוצה שאמות,"],[69380,72370,"ואני פחות ופחות דואגת לשלומך."],[72420,74450,"אז מה אנחנו עושים?"],[74500,76250,"מהבמאי של \"זהות כפולה\"."],[76300,79810,"קדימה, מותק, בואי לאבא."],[79860,81490,"מי האבא שלך עכשיו?"],[81540,83380,"בראד פיט, ג'ולי."],[87220,89360,"את עדיין בחיים, מותק?"],[98300,100930,"אה... מר וגברת סמית'."],[100980,102820,"אתה יודע שאתה..."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"מר וגברת סמית'","y":2005,"k":"movie","f":2,"ts":1795293088}