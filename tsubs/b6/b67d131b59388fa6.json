{"c":[[6210,8820,"עבדנו קשה בשביל העסק הזה."],[8820,10440,"ישבנו בכלא."],[10440,11640,"איבדנו אחים."],[11640,15190,"שפכנו המון דם."],[15190,17340,"לא קל להיות מלך –"],[17340,18710,"תזכור את זה."],[21370,24310,"המועדון הזה צריך לסגור חשבון."],[29000,31320,"מה שאני עושה עם המשפחה שלי לא עניינך."],[31320,32750,"יש לך מושג מי בעלך?"],[32750,34010,"למה הוא מסוגל?"],[38150,38950,"אתה מת!"],[38950,40610,"מת!"],[40610,43040,"אתה מנסה להפחיד אותי?"],[43040,47050,"אתה צריך לקבל את ההחלטה הקשה, בן."],[47050,48790,"בגידה היא בלתי נסלחת."],[54690,56280,"אני לא הולך לאבד את המועדון שלי."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"ילדי האנרכיה","y":2008,"k":"tv","f":2,"ts":1795664606}