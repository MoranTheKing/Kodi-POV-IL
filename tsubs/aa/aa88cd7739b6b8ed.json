{"c":[[1100,3050,"מה מביא אותך לכאן, לביקונס?"],[3100,5450,"הייתי צריך שינוי ומקום..."],[5500,6810,"בהצלחה."],[10800,12940,"מרגישה שאנחנו לא לבד?"],[13200,14750,"אין דבר כזה רוחות רפאים."],[14800,17150,"הבית הזה עושה משהו לאנשים."],[17200,19050,"האישה הזקנה, ראיתי אותה."],[19100,21900,"את בטוחה שמה שקורה פה אמיתי?"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"The Witch Farm","y":2026,"k":"tv","e":1,"f":2,"ts":1795652484}