{"c":[[380,1420,"קובי: זו העבודה הראשונה שלך?"],[2790,4090,"קובי: קצת מאוחר להסבה מקצועית, לא?"],[7010,9430,"רורי, אתה רוצה להסתדר עם הבן שלך?"],[10180,11090,"לא יכולתי להסתכל לו בעיניים."],[11850,14640,"רורי: משכנתא, מזונות. זה עליי."],[15270,17640,"רורי, אתה בטוח שניסית הכל?"],[18270,18850,"לא הכל."],[21350,23020,"בסגאי: יש לי מכה של פעם בחיים..."],[25190,25900,"בסגאי: אתה המארינס?"],[26400,26860,"כן."],[26860,27690,"ואתה האסיר לשעבר?"],[28700,31450,"כן, ישבתי. אבל אל תזלזל בי, חבר."],[31740,32240,"אני מנסה. - סע."],[32280,33120,"יופי. תפסיק לדבר."],[33620,34740,"קול מחשב: לא זוהה אלכוהול."],[36410,37120,"בסגאי: בעוד כשבוע,"],[37540,40210,"בסגאי: לראש העיר יש מסיבה בליל הבחירות."],[40250,40830,"יאללה!"],[41830,44790,"בסגאי: יהיה שם כסף שאף אחד מכם המובטלים לא ראה בחיים."],[45800,46550,"קובי: זו העבודה הראשונה שלך?"],[46840,47590,"אני יודע מה אני עושה."],[47960,50010,"קצת מאוחר להסבה מקצועית, לא? בן כמה אתה, 60?"],[50670,51300,"רורי: שאלה מהירה."],[51300,53840,"אם אני נותן הוראות והם לא מקשיבים?"],[53840,55180,"פשוט תגיד: \"יש לי אקדח\"."],[56720,57390,"סקאלבו: מה אתה עושה?"],[58390,58980,"רושם הערות."],[59270,60850,"רושם הערות על קשירת קשר לפשע."],[62980,63850,"קובי: זוז!"],[64150,65310,"רורי: לרצפה!"],[65310,66320,"רורי: תרד ל-"],[68610,69150,"תקשור אותו!"],[69820,71200,"קובי: יש לנו איזה שישה אזיקונים, גאון."],[72360,73110,"יש לי אקדח!"],[73160,74200,"מלצרים: אהה!"],[79540,81660,"דצ'יקו: אנחנו חייבים למצוא אותם לפני המשטרה..."],[83880,85460,"ולחסל אותם לפני שהם ידברו."],[86170,87880,"כל ניו אינגלנד דולקת אחרינו."],[88800,89880,"אה, אני חייב לדבר איתך."],[91050,92380,"אני ממש צריך אותך עכשיו, דוקטור."],[92550,93760,"אני אעבור על החוק."],[93760,94720,"מה אם אני אקח אותך כבת ערובה?"],[95300,97430,"כלומר, כאילו, אתה יודע, בהסכמתך?"],[97930,99270,"קובי: איזה מין שיחה זו?"],[99890,100770,"אתה תאהב אותו."],[103350,105480,"רורי, אתה נוהג בפזיזות."],[108820,110440,"אני באמצע מרדף מכוניות מהיר."],[111490,113490,"תחשוב על האדם שרצית להיות."],[113910,115240,"איזה מין אדם אתה רוצה להיות?"],[117490,118410,"סע, סע, סע, סע!"],[121290,122580,"אתה יוצא איתי."],[122790,123920,"אבל אני בת הערובה שלהם..."],[125000,126290,"והפסיכיאטרית שלהם."],[128750,129750,"את מקבלת שכר נמוך מדי."],[130130,131000,"כן, בטח."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"The Instigators","y":2024,"k":"movie","f":2,"ts":1795688945}