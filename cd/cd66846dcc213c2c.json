{"c":[[6940,8130,"ראית במו עיניך מה הם עשו בהר?"],[8180,11570,"הם פיצצו את ההר."],[11620,15360,"ראיתי אבק פחם יורד מהשמים כמו שלג."],[24060,25840,"איך שם למטה?"],[26220,29080,"מוזר פה למטה."],[29180,31200,"תסתלקי משם, לעזאזל."],[36460,37810,"בעלי נעדר."],[37860,40720,"ג'סי היה במכרה בזמן הפיצוץ."],[43180,46400,"ג'סי חי שם למטה, אני מרגישה את זה."],[48060,50430,"אל תתנו להם לפתוח את ההר."],[51260,54040,"אל תתנו לזה לצאת."],[54500,56570,"מה יש במורד ההר הזה?"],[56620,58990,"חייבים להשאיר את זה כלוא."],[59980,61590,"זה לא אנושי."],[62820,65250,"אני הולכת להוציא אותו משם."],[69100,71520,"האפלה הזו באדמה."],[72460,74300,"היא צדה ב\"הולו\"."],[83140,84520,"זה מגיע."],[85220,87000,"זה רעב."],[91580,95360,"יש לך אחריות כלפי האדמה הזאת."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Dark Hollow","y":2026,"k":"movie","f":2,"ts":1795372379}