{"c":[[2980,4210,"ננשכתי. זה הסוף."],[4260,5770,"אנחנו נפתור את זה, מאמי."],[5820,6120,"אני צריכה גישה לתרופה."],[6120,6490,"תעביר את המזוודה לניו הייבן."],[6540,7970,"תעשה את זה ותקבל את התרופה שלך."],[8020,8850,"אנחנו חייבים לעבוד יחד."],[8900,9200,"כך או כך."],[9220,10810,"יש לך משהו ששייך לי. ואנחנו נמצא אותו."],[10860,11330,"תפתחו את השערים."],[11380,12250,"תצילו את הטובים ותהרגו את הגנב."],[12300,15200,"אני לא יודע מה לעזאזל זה הדבר הזה."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Resident Dead","y":2026,"k":"movie","f":2,"ts":1795286715}