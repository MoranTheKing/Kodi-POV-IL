{"c":[[1210,3590,"לפעמים כל מה שאתה יכול לעשות זה למלא את תפקידך..."],[4090,5840,"ולנסות לעשות שינוי."],[5920,6630,"השטח נקי."],[6710,7720,"בעמדות."],[10050,12010,"אני צריך שני צלפים למבצע דחוף."],[12550,14010,"זה נשמע כמו משהו מסרטי ג'יימס בונד."],[18100,19230,"עכשיו מתחילה העבודה האמיתית."],[19890,20560,"להיכנס לעמדות."],[21230,22810,"-מוכנים לחילוץ? -נקי."],[23980,24820,"בעקבותיו."],[27940,28740,"זוזו מהר."],[31740,32409,"מה הסטטוס שלנו?"],[33740,34410,"בדרך."],[36660,37830,"תדע שהמשימה הזו..."],[38250,39500,"היא עכשיו או לעולם לא."],[40210,41670,"כולנו עמוק בפנים יותר ממה שחשבנו."],[43460,45090,"ערפל הקרב, אח שלי."],[45170,47420,"שני צדדים שמנסים לעשות את הדבר הנכון."],[50090,51300,"מי ייתן והאומץ שלנו יגבור על..."],[51380,52630,"-מחליף מחסנית! -זוז!"],[52890,54340,"...רמת האלימות שלנו."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"רשימת חיסול: זאב אפל","y":2025,"k":"tv","e":1,"f":2,"ts":1795207931}