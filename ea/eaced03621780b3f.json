{"c":[[1970,3900,"הצוות שלך פולש לרכוש שלנו."],[3950,5130,"אנחנו לא יכולים לעצור את קוסטס."],[5180,7900,"ילדים טיפשים החליטו לצאת לטיול."],[10190,13960,"הוא לא היה לבד, הבן שלי היה איתו."],[16780,19100,"כלומר, ילד אבוריג'יני ותרמילאי."],[19150,22750,"אף אחד לא שולח את הטובים והמבריקים שלו לחפש נעדר."],[22800,24900,"בלי להעליב."],[25470,27500,"הבן שלי לא מת."],[27550,28310,"בסדר?"],[28360,31190,"אני יודע איך לעשות את העבודה שלי היטב."],[31240,33850,"העבודה שלך גורמת לאנשים למות."],[34800,38110,"אתה מדבר על האמת, אבל לא אוהב לשמוע אותה."],[40430,41950,"זה מגעיל."],[42000,43550,"לא, אדוני."],[46630,49020,"באמצע המעגל הזה."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Mystery Road","y":2018,"k":"tv","e":1,"f":2,"ts":1795341591}