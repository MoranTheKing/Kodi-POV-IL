{"c":[[1700,4720,"לוס אנג'לס, 1981."],[4720,6380,"אני זוכר את זה כל כך בבירור."],[12960,15100,"כשהתכוננו להתחיל את שנת הלימודים האחרונה..."],[15100,16820,"ברוכים הבאים, כולם."],[23600,24400,"הלו?"],[27580,29280,"לא היה לי מושג שהחברים שלי ואני"],[29280,34180,"נהפוך למטרה של אחד הרוצחים הסדרתיים הכי מטורפים שהיו."],[45790,47640,"המשטרה חושדת בסבירות גבוהה שמדובר"],[47640,50860,"במעשיו של רוצח סדרתי המכונה \"הטרולר\"."],[56240,61350,"אולי כדאי שנעביר את המסיבה פנימה?"],[66780,68780,"יש פה מישהו?"],[68780,69720,"הלו?"],[80750,82100,"אני פשוט מרגיש שמשהו"],[82100,83780,"גדול יותר קורה כאן."],[83780,85280,"את באמת חושבת שעלית על משהו,"],[85280,86980,"ננסי דרו?"],[86980,89400,"שש, שש, שש."],[95300,97220,"יש כל כך הרבה שאתם לא יודעים."],[98900,101560,"עלתה בדעתי מחשבה, כש..."],[104740,109900,"...מדברים על מה שקרה לנו ב-1981,"],[109900,113400,"שהילדים של היום חיים בפיקניק."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"הרסיסים","y":2026,"k":"tv","e":1,"f":2,"ts":1795350347}