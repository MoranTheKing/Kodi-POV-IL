{"c":[[300,2600,"גבירותיי ורבותיי,"],[2800,4450,"אנחנו עומדים להתחיל בטיפוס."],[4500,7000,"נא לחגור חגורות בטיחות."],[8200,10280,"אני בדרך להר קילגור."],[11100,13650,"אני מחכה לראות מה יש לכם."],[13700,15780,"זה הולך להיות פיצוץ."],[17500,20220,"אנחנו אמורים להגיע לפסגה, אולי."],[26900,28620,"צ'ארלס, מה זה?"],[30000,31850,"יש לך התרעה מוקדמת על מפולת?"],[31900,33950,"כן, המדרונות הצפוניים."],[34000,34750,"זה בשידור חי?"],[34800,35750,"עוד 10 שניות."],[35800,37880,"אמא, את מפחידה אותי."],[38300,40550,"את רואה למה אני מתכוון?"],[40900,43210,"נשארו לנו אולי 40 שניות."],[45700,47400,"תחזיקו במשהו."],[61800,64879,"את חייבת לעזור לי לכוון את זה, אוקיי?"],[67800,69990,"אני לא מכיר פה אף עיר."],[71800,73170,"זה מסוק."],[73400,75010,"זה רעש משנה."],[97400,98150,"אנחנו פה."],[98200,99600,"זה בדרך."],[100700,101950,"אבל זה ייקח ימים."],[102000,103800,"כל העיר שלך..."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Frostbite","y":2026,"k":"movie","f":2,"ts":1795629172}