<?xml version="1.0" encoding="utf-8"?>
<window>
	<onload condition="!Player.PauseEnabled + [$EXP[POVIL_NativePlayer] | Skin.String(__chooseplayer,__simpleplayer)]">SetFocus(603)</onload>
	<defaultcontrol always="true">201</defaultcontrol>
	<depth>DepthOSD</depth>
	<controls>
		<include condition="$EXP[POVIL_NativePlayer]">POVIL_OriginalPlayer</include>
		<include condition="Skin.String(__chooseplayer,__advancedplayer)">POVIL_Player_videosd1</include>
		<include condition="Skin.String(__chooseplayer,__netflixplayer)">POVIL_Player_videosd2</include>
		<include condition="Skin.String(__chooseplayer,__simpleplayer)">POVIL_Player_videosd3</include>
		<include condition="Skin.String(__chooseplayer,__prettyplayer)">POVIL_Player_videosd4</include>
	</controls>
	<onload condition="$EXP[POVIL_NativePlayer] + Player.PauseEnabled">SetFocus(602)</onload>
</window>
