{"c":[[2740,3850,"אז איפה אתה?"],[3900,5960,"אתה בבית מלון."],[8980,12850,"אולי אתה שם שבוע?"],[12900,14980,"אני אהרוג אותך, לני."],[16540,17650,"אין כלום במגירות."],[17700,19130,"בוא נבדוק בכל זאת."],[19180,20650,"זה סתם חדר אנונימי."],[20700,22130,"היי, לני!"],[23740,25450,"הוא הרגע אמר לי שקוראים לו טדי."],[25500,27580,"אל תאמין לשקרים שלו."],[28460,30010,"תהרוג אותו."],[31540,33530,"אשתי נהגה לקרוא לי לני."],[33580,35420,"כן, שנאתי את זה."],[40660,43010,"הוא תמיד איתי, מנסה לגרום לי להרוג את הבחור הלא נכון."],[43060,47720,"כשמצאת את הבחור הזה, ג'ון ג', מה אתה הולך לעשות?"],[50740,52290,"להרוג אותו."],[52380,55250,"יש דברים שאתה יודע בוודאות."],[55300,56890,"מי לעזאזל אתה?"],[56940,58090,"החבר שלך?"],[58140,60130,"אי אפשר לדעת שום דבר בוודאות."],[60180,62090,"אבל השארתי רושם חזק מספיק על..."],[62140,66730,"תבקש סליחה מאשתי, לפני שאני מפוצץ לך את המוח."],[66780,68560,"הוא מצחיק, לני."],[82140,83390,"מי זה?"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"ממנטו","y":2000,"k":"movie","f":2,"ts":1795776139}