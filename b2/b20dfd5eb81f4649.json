{"c":[[9220,12330,"האדם הכי לא מתאים, הכי לא מתאים בעולם."],[12380,15030,"זו הילדה הקטנה שלי."],[15080,18270,"מה, בת כמה את?"],[18320,19460,"בוב."],[19760,21150,"אני לא יודע."],[21200,22890,"אתה אוהב אותה?"],[22940,24700,"היא יפהפייה."],[26660,29320,"זה סתם סוג של פחזנית, או..."],[29420,29850,"כן, למה?"],[29900,31900,"למה את מתנהגת ככה?"],[33200,35740,"אני אעשה אותך כל כך מאושרת."],[36200,38510,"בדיוק הסוג שלי של גבר."],[38560,41860,"אתה חושב שאולי אני צריכה פשוט להראות?"],[49340,51650,"ככה אתה מתכוון לגמול לי?"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"ילדה יפה","y":1978,"k":"movie","f":2,"ts":1795800135}