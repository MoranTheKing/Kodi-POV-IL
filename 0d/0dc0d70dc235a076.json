{"c":[[880,2000,"אתה באמת מאמין שאנחנו צריכים"],[2080,4040,"לכרוע ברך בפני מלך מעבר לים?"],[5380,6380,"אבא אמר שהארץ הזו..."],[7540,8580,"היא המקום היחיד..."],[10420,11790,"שבו נוכל להיות חופשיים באמת."],[12040,13420,"לעמדות קרב!"],[13500,14460,"למטה!"],[16170,16880,"לא!"],[18000,19710,"אני כמהה לעולם שאבא הבטיח."],[21120,22830,"העולם החדש הוא בדיוק כמו הישן."],[24250,24960,"בשבילך."],[25040,27000,"אדוני, אין לי צורך בפרח כזה."],[27830,28960,"אבא מת בשביל שקר."],[34500,35790,"המלחמה בפתח!"],[35880,37750,"כל מי שלא מוכן להגן"],[37830,40170,"על המלך והמולדת הוא בוגד!"],[43170,44880,"האנשים כאן לא מוכנים לשלוט בעצמם."],[45080,45920,"אבל הם מרגישים כלואים."],[46080,46920,"גם אבא הרגיש כך."],[47170,48500,"למען המהפכה!"],[53080,53960,"תזכרו אותנו."],[54120,55170,"ותזכור את עצמך."],[56620,58500,"אתה נלחם למען הרודנים!"],[59080,60500,"באיזה צד אתה תילחם, בן?"],[60750,61620,"בצד הבוגדים?"],[62000,62920,"אולי."],[63710,66420,"שבוע אחד של גרירת הרגל חסרת התועלת שלך"],[66500,67120,"יספיק כדי להביא למותם"],[67210,68380,"של כל אחד ואחד מהם."],[73420,74920,"טוב, בסדר גמור."],[76040,78460,"יש רעיונות שגדולים יותר מאחווה."],[80620,81460,"קדימה!"],[85040,85880,"אחי,"],[85960,87380,"הוא מתופף, אדוני,"],[87460,88830,"בצד השני."],[89460,90620,"אז הוא בחר את הבחירה שלו."],[91920,93000,"וכך גם אתה."],[94710,96750,"אני כמה לעולם שבו אוכל לבחור בך."],[102000,103750,"התפללתי למען החופש שלי."],[105460,107040,"עכשיו אתפלל למען שלך."],[110000,110960,"אני מסוגל להילחם."],[111880,112670,"התופים האלה"],[112750,115120,"חשובים לאנשים האלה יותר ממה שאתה חושב."],[115500,116330,"וגם אתה."],[126000,128710,"אתה תניף את החרב נגד אחיך,"],[128789,131000,"או שתמות על סירוב פקודה!"],[132170,134290,"לא משנה מה יקרה, תמיד נהיה אחים."],[143880,145000,"על ה--"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"Drummer Boy","y":2026,"k":"movie","f":2,"ts":1795210575}