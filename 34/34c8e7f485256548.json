{"c":[[4660,6710,"אנחנו כמעט שם."],[6760,10780,"מה זה הבניין הזה? נראה כמו שער, לא?"],[14840,16170,"אסור לך להיות כאן, תחזרי מיד!"],[24020,29440,"זהו בית מרחץ, מקום שאליו באים האלים לנוח."],[29980,35020,"זה לא מקום לבני אדם."],[42620,42930,"אל תפחדי."],[42980,45400,"אני בצד שלך."],[49640,51230,"את לא שוכחת את מה שקרה."],[51280,53860,"את רק לא זוכרת."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"המסע המופלא","y":2001,"k":"movie","f":2,"ts":1795795021}