{"c":[[7920,11640,"נוסעים אחרונים בטיסה KA29,"],[11640,14640,"נא להגיע לשער B15."],[15470,18390,"בוקר טוב לכולם, כאן קפטן רובין אלן מדבר."],[18640,22610,"זמן הטיסה היום: 6 שעות ו-54 דקות."],[33280,34200,"תישארו במושבים!"],[34200,35280,"לרדת למטה, עכשיו!"],[37080,38910,"המבצע החל."],[38910,40160,"טלפונים, טאבלטים."],[40160,41420,"המטוס בשליטתנו."],[43460,44420,"אתם חייבים לראות את זה."],[44840,46340,"המטוס סטה מהמסלול."],[47210,48590,"מישהו מבקש עזרה."],[52640,54180,"יש לך משפחה? אנשים אהובים?"],[54720,56180,"יש לנו משימה אחת כרגע."],[56180,57810,"רק לעבור את זה בשבילם."],[58270,60140,"קיבלתי הודעה מהמטוס."],[60600,62520,"אבא אומר שיש אירוע על הסיפון."],[63440,65610,"מה בדיוק אבא שלך עושה למחייתו?"],[65610,66980,"זה קצת מסובך להסביר."],[66980,68530,"סם הוא הכי טוב בלנהל את זה."],[68780,69490,"לנהל מה?"],[70440,71450,"את המשא ומתן."],[74280,76080,"יש 200 אנשים בטיסה הזו."],[77160,78620,"אם הם ינסו משהו,"],[79500,80620,"והמטוס הזה יתרסק."],[81080,82920,"אני לא אחזור למשפחה שלי."],[84250,85960,"תן לי להציע לך הצעה."],[87550,89840,"קיבלתי את הדרישות שלהם."],[89840,91300,"אם הכל משתבש כבר בשעה הראשונה,"],[91970,92970,"תחשבו על 6 השעות הבאות."],[93840,96310,"אנחנו צריכים להעביר מסר לכל המטוס."],[97010,98220,"אנחנו רק צריכים להיות מוכנים."],[102020,103640,"קורים עוד דברים."],[103640,106110,"חמישה נוסעים במטוס הזה לא קיימים."],[106730,109400,"זו רשת שפועלת בכל אירופה."],[110230,111990,"מבחינתם, אנחנו טיל בדרך."],[116370,118330,"זה או אנחנו או הם."],[119200,121700,"ואני יכול להגיד לכם שזה לא נהיה אנחנו."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"Hijack","y":2023,"k":"tv","e":1,"f":2,"ts":1795548281}