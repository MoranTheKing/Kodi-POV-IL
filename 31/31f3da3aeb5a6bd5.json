{"c":[[5840,10680,"רון: מוגבלות היא לא טרגדיה."],[13890,18350,"היא מטרד..."],[21940,23070,"עצום."],[24650,25610,"או, תודה לאל."],[26190,27030,"סליחה."],[28070,29110,"אני חייבת לשירותים."],[30820,32320,"אוון: אנחנו בסן פרנסיסקו היום,"],[32409,33580,"איפה שמאות נכים"],[33660,35080,"התאספו כדי למחות."],[35160,36700,"לחתום על סעיף 504!"],[36790,40620,"הממשל הפדרלי לא יכול לגנוב את הזכויות האזרחיות שלנו!"],[42580,44380,"הם רואים אותך מול המדרגות,"],[44460,46090,"וחושבים שאת/ה הבעיה."],[47090,48720,"המדרגות הן הבעיה!"],[50340,51340,"אוקיי!"],[51430,52430,"ג'וזף קליפאנו, בבקשה."],[52510,53340,"זאת ג'ודי היומן."],[53430,54050,"ג'ודי היומן."],[54850,55930,"מי זאת האישה הזאת?"],[56010,57310,"ג'וזף: יש לך מושג כמה יעלה"],[57390,58680,"ליישם את התקנות האלה?"],[58770,60020,"2.4 מיליארד."],[60100,60640,"מיליארד!"],[60730,62150,"ג'וזף: אני מרחם על האנשים האלה."],[62230,63810,"מישהו צריך לצאת לשם ולהגיד להם."],[63900,65690,"תגיד להם בעצמך, הם נכנסים פנימה."],[67400,69240,"יש לי מאה נכים במשרד."],[71110,73070,"יש לנו שישים יום לשנות את העולם!"],[73160,75200,"ג'וזף: הם לא מבקשים מקום באוטובוס,"],[75280,76780,"הם מבקשים אוטובוס חדש לגמרי!"],[78290,79500,"מה אם זה לא יעבוד?"],[79580,81040,"חשבתי שאת רדיקלית."],[81120,82210,"כן."],[83330,85880,"אנחנו לא עוזבים את הבניין הזה"],[85960,88340,"עד שהתקנות האלה ייחתמו."],[88960,90090,"תספרו את הפנתרים בפנים."],[92970,94180,"אני לא עולה לשם."],[94470,95340,"את עולה לשם?"],[99560,101020,"ג'ודי: הם רוצים להרעיב אותנו."],[101100,102730,"יאללה, בייבי!"],[103100,104270,"כולנו לומדים."],[104350,104850,"ממ... כן."],[104860,106770,"לכל אחד יש את נקודות העיוורון שלו."],[106860,108360,"לא, אל תגיד נקודות עיוורון."],[108440,109400,"לי זה סבבה."],[111440,113110,"אד: נלחמתי לגמרי לבד."],[114780,115780,"ובכן..."],[117120,118620,"לא עוד."],[120540,122790,"ג'ודי: זה הרבה יותר גדול מאיתנו."],[122870,123710,"צ'אק: יש לנו רץ!"],[127670,129000,"אוון: אם אנשים ישמעו את הסיפור הזה..."],[129750,130590,"הם יקבלו השראה."],[133880,136970,"השראה לעשות משהו, או סתם השראה?"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"Being Heumann","y":2026,"k":"movie","f":2,"ts":1795688660}