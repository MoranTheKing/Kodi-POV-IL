{"c":[[14260,15530,"הצלחת."],[15580,16890,"אני כאן."],[16940,19090,"אני רק רוצה להנות איתך השבוע, אוקיי?"],[19140,20210,"כשאת חוזרת למשרד,"],[20260,23090,"אני בחופשה. נדבר אחר כך. אוקיי, ביי."],[23140,25040,"אני הולכת למסיבה."],[39020,40450,"אני מאיה."],[44180,47930,"פגשתי אישה אפגנית קווירית. היא עובדת במועדון חשפנות."],[47980,49010,"מועדון חשפנות?"],[49060,52330,"אישה אפגנית בחיים לא תחפיץ את עצמה מרצון."],[52380,55010,"היא מינית. היא שלמה עם עצמה."],[55060,59450,"אני צריכה להסתכל עלייך מתי שבא לי. אני רוצה לספר את הסיפור שלך."],[59500,61890,"את כותבת על סקס, נכון?"],[61940,63410,"עכשיו אני רוצה לכתוב עליי."],[63460,64090,"למה?"],[64140,65770,"כי אני חושבת שאת אמיצה."],[65820,68250,"יש בחור אחד שעושה לי צרות."],[69140,71970,"את חושבת שהיא במצב פגיע?"],[72020,74040,"את מנסה להציל אותה?"],[84460,86290,"הלוואי שהייתי עדיין איתך."],[86340,88530,"לא צפית את זה, מאיה?"],[88580,90240,"זה בשבילה."],[95780,97090,"השתמשת בי."],[97140,99280,"אולי גם את השתמשת בי."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"Maya & Samar","y":2026,"k":"movie","f":2,"ts":1795371147}