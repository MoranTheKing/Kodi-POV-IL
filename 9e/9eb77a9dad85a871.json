{"c":[[300,2330,"הישבעו את השבועה, מוריין.|"],[2380,3530,"למות.|"],[3580,6490,"אני נשבעת לא לומר מילה שאינה אמת,|"],[6540,10090,"לא ליצור כלי נשק שאדם יוכל להרוג בו אחר,|"],[10140,12980,"ולעולם לא להשתמש בכוח האחד כנשק.|"],[14460,15610,"את יודעת מה המשמעות של מה שאמרתי?|"],[15660,22760,"בעידן הישן, משרתי כולם - הם המשרתים את העולם.|"],[26060,27370,"לא בחרתי בדרך הזו,|"],[27420,29400,"אבל אלך בה.|"],[30140,32170,"לאן? לשני הנהרות.|"],[32220,35000,"הדם העתיק זורם עמוק בהרים האלה.|"],[38220,39450,"נקווה שהוא מוכן אז,|"],[44860,46920,"כי האפל מתעורר.|"],[48300,51480,"אבל יהיה אחד שיוכל לעמוד מולו.|"],[52380,54600,"וזה אחד מחמישתכם.|"],[55500,57610,"איבדת לגמרי את השפיות?|"],[57660,60800,"חייך לא הולכים להיות מה ש... מה את...|"],[62940,65370,"מי אלו?|"],[65420,67200,"הצבא שלו מגיע.|"],[69260,71510,"מה אנחנו יכולים לעשות?|"],[81420,83670,"האויבים שלנו בכל מקום.|"],[84060,86550,"הם לא ישאירו אף אחד בחיים.|"],[86940,89050,"כבר איבדנו יותר מדי אנשים.|"],[89100,90880,"בחזרה לא תלכו.|"],[94780,97400,"אם לא נעצור את האפל עכשיו,|"],[97980,100280,"כל העולם יישרף.|"],[101580,103950,"אני לא יכולה להרשות זאת.|"],[111580,114280,"הגלגל טווה כרצון הגלגל.|"],[121980,124290,"את חושבת שאי פעם נחזור?|"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"מחזור כישור הזמן","y":2021,"k":"tv","e":1,"f":2,"ts":1795713077}