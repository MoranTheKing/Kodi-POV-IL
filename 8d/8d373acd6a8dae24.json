{"c":[[7900,9050,"שלום, קתי."],[9100,10410,"אני לא יכול להגיע הלילה."],[10460,11290,"לאן אתה הולך?"],[11340,12330,"אני לא יכול לומר לך."],[12380,14010,"ג'ק, תגיד לה לאן אתה הולך."],[14060,15450,"למעשה, תגיד לה עבור מי אתה עובד."],[15500,16730,"היא אמורה להתרשם."],[16780,17930,"אני עובד עבור ה-CIA,"],[17980,18970,"והראש ביקש ממני"],[19020,20490,"ברגע האחרון לבוא איתו לרוסיה"],[20540,22490,"כדי לבצע פיקוח על נשק גרעיני."],[22540,24090,"זה כל כך..."],[29420,31290,"אתה עומד לנשום אוויר שגדול על המידות שלך."],[31340,32090,"אז תקשיב טוב."],[32140,34010,"אתה עומד להתבקש לספק ניתוח ועצות."],[34060,36250,"אז תוודא שאתה יודע על מה אתה מדבר."],[36300,38570,"ברוך הבא לספורט של ה-CIA."],[38620,40570,"בתקופה של מתח גובר."],[40620,44010,"לפי זה, יש היום 17 מדענים בכירים בתפקיד."],[44060,45210,"אני סופר רק 14."],[45260,46490,"הטעיה מכוונת."],[46540,48170,"שלושה מדענים רוסים נעדרים."],[48220,49690,"אני צריך לדעת איפה הם."],[49740,50330,"סתום את הפה."],[50380,51690,"אני לא יוצא למשימות שטח."],[51740,52730,"אני רק כותב דוחות."],[52780,54090,"אז תכתוב דוח על זה."],[54140,54890,"אני אנליסט."],[54940,56090,"אני לא מאומן לזה."],[56140,58800,"רק תהיה העיניים והאוזניים שלי."],[60460,63290,"אני לא יכול להיות עם מישהו שמסתיר ממני את חייו."],[63340,65850,"ג'ק, אני לא אתן לזה לקרות."],[65900,67210,"ואויבים חדשים."],[67260,69690,"אתה לא נלחם ברוסיה ובאמריקה."],[69740,74410,"אתה גורם לרוסיה ואמריקה להילחם ולהשמיד זו את זו."],[74460,76810,"רק שני גברים חושדים באמת."],[76860,78730,"מה דרום אפריקאי עושה באוקראינה?"],[78780,80890,"שלושה מדענים רוסים בתוך ארגז מישראל."],[80940,81450,"ניחוש הוגן."],[81500,83290,"הם בונים פצצה."],[83340,86250,"מהרב-מכר המחשמל של טום קלנסי."],[86300,89530,"הארגז הועלה על ספינת מטען בדרך לחוף המזרחי."],[89580,90090,"מה?"],[90140,93450,"ומהמפיק של \"סכנה ברורה ומיידית\" ו\"משחקי בוגדנות\"."],[93500,94330,"זה ריאן."],[94380,96760,"הפצצה בתנועה."],[102540,103530,"בן אפלק."],[103580,104890,"איפה הנשיא עכשיו?"],[104940,105930,"הם מטיסים אותו לאוויר."],[105980,107130,"הם חושבים שאולי אלו הרוסים."],[107180,108330,"אלו לא היו הרוסים."],[108380,109370,"מורגן פרימן."],[109420,110170,"זה מסתדר."],[110220,112410,"פשוט לא מוצא חן בעיניך מה שזה מסתדר אליו."],[112460,115850,"אם תתקוף את הרוסים, תקריב את הסמכות המוסרית שלך."],[115900,120150,"יש לנו סיבה להאמין שהפצצה היא עבודת טרוריסטים, לא הרוסים."],[120860,124490,"אדוני הנשיא, הם מזניקים את ה..."],[124540,127930,"הפקודות שלי הן להעביר את המידע הנכון לאנשים שמקבלים את ההחלטות."],[127980,129210,"שים את זה בדוח שלך."],[129259,134440,"ואם תחסום אותי, המשפחה שלך ועוד 25 מיליון משפחות ימותו."],[136620,139210,"כל הפחדים כולם."],[139260,141640,"בימוי: פיל אלדן רובינסון."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"כל הפחדים כולם","y":2002,"k":"movie","f":2,"ts":1795378473}