{"c":[[2080,3460,"אתה מסוגל לזה, אחי."],[4670,6550,"אתה רק צריך לצאת לשם ולטרוף את הבמה."],[19310,20940,"איפה ראיתי אותו קודם?"],[21060,23060,"אני די בטוח שהוא היה טרוריסט בעבר."],[27440,28320,"זה אינטנסיבי."],[28860,31450,"בוא לא נשדר לו שום אנרגיה מוזרה."],[31530,33660,"לשנינו יש הרבה מה להפסיד פה, סיימון."],[33780,34950,"למה שתגיד את זה?"],[36370,37330,"תיכנס."],[37700,39370,"מר קובאק יפגוש אותך בסלון."],[39460,40660,"מדהים!"],[49220,50840,"גרסה מחודשת לגיבור על."],[51590,54850,"לא בדיוק מה שהיינו מצפים מבמאי זוכה אוסקר."],[55180,57270,"זה התפקיד. זה הכל."],[57390,60060,"אם אני אגיע כל כך קרוב, ואפספס."],[63350,65310,"אני צריך שתחתום כאן,"],[65440,67230,"כדי לאשר שאין לך כוחות על."],[67690,68360,"כן."],[71650,73200,"אני חייב להיות בסרט הזה."],[75450,77700,"נולדתי לגלם את הדמות הזאת."],[77870,81330,"משחק הוא סך כל החוויות שעברת בחיים."],[82960,83750,"השמחה."],[84420,85000,"העצב."],[85670,86250,"האובדן."],[86710,87840,"שברון הלב."],[95180,96850,"המחלקה לבקרת נזקים"],[96970,100430,"רואה בסיימון ויליאמס איום חריג."],[109110,109570,"מה?!"],[116700,118530,"אתה הולך להשתמש במהירות על או מה?"],[118580,119950,"אני הולך להשתמש באוטו שלי, טרבור."],[120040,122370,"זה אומר שיש לך או אין לך מהירות על?"],[122450,123000,"בוא נזוז!"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"וונדר מן","y":2026,"k":"tv","e":1,"f":2,"ts":1795472801}