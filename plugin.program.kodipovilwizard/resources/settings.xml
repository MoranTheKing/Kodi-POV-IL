        <setting type="lsep" label="אירועי לוג ב-Wizard"/>
        <setting id="debuglevel" type="enum" label="בחר Wizard Log Level" values="ללא|רגיל|מלא" default="1"/>
        <setting id="wizardlog" type="bool" label="הפעל לוגים מה-Wizard" default="true"/>
        <setting id="autocleanwiz" type="bool" label="ניקוי לוג אוטומטי ב-Wizard" visible="!eq(-1,false)" default="true"/>
        <setting id="wizlogcleanby" type="enum" label="על פי מה לנקות לוג Wizard?" visible="!eq(-2,false)+!eq(-1,false)" values="ימים|גודל|שורות" default="1"/>
        <setting id="wizlogcleandays" type="enum" subsetting="true" label="בחירת ימים לשמירת הלוג" enable="!eq(-2,false)" visible="eq(-1,0)+!eq(-2,false)+!eq(-3,false)" values="1|2|3|7" default="2"/>
        <setting id="wizlogcleansize" type="enum" subsetting="true" label="גודל מקסימלי עבור wizard.log" enable="!eq(-3,false)" visible="eq(-2,1)+!eq(-3,false)+!eq(-4,false)" values="100 KB|200 KB|300 KB|400 KB|500 KB|1 MB" default="1"/>
        <setting id="wizlogcleanlines" type="enum" subsetting="true" label="מספר שורות מקסימלי בשמירת wizard.log" enable="!eq(-4,false)" visible="eq(-3,2)+!eq(-4,false)+!eq(-5,false)" values="100|200|300|400|500" default="2"/>
