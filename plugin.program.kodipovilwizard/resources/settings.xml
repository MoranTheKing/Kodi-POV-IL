        <setting id="keepacctmgr" type="bool" label="שמור נתוני חשבונות (Account Manager Lite)" default="true"/>
        <setting id="keeppovdata" type="bool" label="שמור היסטוריה ומועדפים (POV)" default="true"/>
        <setting id="keepumbrelladata" type="bool" label="שמור היסטוריה ומועדפים (Umbrella)" default="true"/>
        <setting id="keepfentasticdata" type="bool" label="שמור הגדרות ועיצוב סקין FENtastic" default="true"/>
        <setting type="lsep" label="שמירת הגדרות קודי בזמן התקנת בילד:"/>
        <setting id="keepfavourites" type="bool" label="שמור מועדפים של קודי (Favourites.xml)" default="false"/>
        <setting id="keepsources" type="bool" label="שמור מקורות קבצים (Sources.xml)" default="false"/>
        <setting id="keepprofiles" type="bool" label="שמור פרופילי משתמש (Profiles.xml)" default="false"/>
        <setting id="keepplayercore" type="bool" label="שמור הגדרות נגן (playercorefactory.xml)" default="false"/>
        <setting id="keepadvanced" type="bool" label="שמור הגדרות מתקדמות (advancedsettings.xml)" default="false"/>
