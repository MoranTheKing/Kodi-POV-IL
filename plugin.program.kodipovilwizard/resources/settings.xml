        <setting id="keeprepos" type="bool" label="שמור מאגרי הרחבות (Repositories)" default="false"/>
        <setting id="keepsuper" type="bool" label="שמור Super Favourites" default="false"/>
        <setting id="keepwhitelist" type="bool" label="שמור רשימת הרחבות מוגנות (Whitelist)" default="false"/>
        <setting id="keepaddons33db" type="bool" label="שמור מסד נתוני הרחבות (Addons33.db)" default="false"/>
