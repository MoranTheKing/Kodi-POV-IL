{"c":[[4740,6400,"מומחה פריצה."],[7980,11640,"וג'יי, מומחה חבלה."],[11860,13130,"הבאתי אתכם לכאן כדי לדעת"],[13180,15410,"אם שניכם יכולים לעבוד כצוות."],[15460,17010,"עברתם את המבחן."],[17060,18310,"בראבו."],[19620,21880,"אני גנב שפרש מזמן."],[22740,24880,"אבל אני גם אבא שלכם."],[26060,27970,"בהתחלה הייתי סקפטי."],[28020,29530,"היי, רוב."],[29580,31600,"אחותי. ג'אז."],[32540,35280,"אני רוצה להציע לכם את העבודה..."],[38140,40390,"אז, מה אתם רוצים לגנוב?"],[40660,41170,"אתה מטורף."],[41220,42770,"זה אבסורדי."],[45980,51280,"כל שוד הוא בלתי אפשרי, עד שמישהו מוכיח אחרת."],[53140,54810,"אתם עדיין סומכים עליו?"],[54860,56010,"אני לא יודע."],[56060,59040,"לא שיקרתי שם, אולי רק קצת."],[61740,63230,"אתם חזקים."],[63300,68920,"אבל יחד, אתם, אני, אנחנו משפחה."],[77660,80880,"ילדים, לא אכפת לכם לחלוק חדר, נכון?"]],"s":"asr","m":"gemini-3.1-flash-lite","n":"תוכנית האב","y":2026,"k":"movie","f":2,"ts":1795366890}