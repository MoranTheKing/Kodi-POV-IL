<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_502" description="All Video Views">
		<control type="group" description="Panel view">
			<visible>Control.IsVisible(502)</visible>
			<control type="group" description="Container and frame">
				<control type="panel" id="502" description="Grid">
					<visible>Container.Content(Movies) | Container.content(tvshows) | container.content(seasons)</visible>
					<viewtype label="$LOCALIZE[31976]">Panel</viewtype>
					<posx>835</posx>
					<posy>69</posy>
					<width>1062</width>
					<height>972</height>
					<orientation>vertical</orientation>
					<pagecontrol>60</pagecontrol>
					<onleft condition="!Skin.HasSetting(ViewOptions_Hide)">9000</onleft>
					<onright condition="$EXP[isEnabledScrollbar]">9001</onright>
					<onup>502</onup>
					<ondown>502</ondown>
					<preloaditems>4</preloaditems>
					<pagecontrol>60</pagecontrol>
					<scrolltime>400</scrolltime>
					<itemlayout height="320" width="265">
						<control type="image">
							<visible>ListItem.IsParentFolder</visible>
							<posx>34</posx>
							<posy>24</posy>
							<width>197</width>
							<height>294</height>
							<texture colordiffuse="$VAR[IconColor]" background="true">DefaultFolderBack.png</texture>
							<aspectratio>scale</aspectratio>
						</control>
						<control type="image">
							<visible>!ListItem.IsParentFolder</visible>
							<posx>34</posx>
							<posy>24</posy>
							<width>197</width>
							<height>294</height>
							<texture background="true" diffuse="img/Round_197x294.png">$VAR[Thumb]</texture>
							<aspectratio scalediffuse="false">scale</aspectratio>
						</control>					
						<control type="image" description="Overlay">
							<!--<visible>![container.content(TVshows) | container.content(seasons)]</visible>-->
							<posx>195</posx>
							<posy>285</posy>
							<height>30</height>
							<width>30</width>
							<aspectratio>keep</aspectratio>
							<texture>$VAR[OverlayPercent]</texture>
						</control>
						<control type="group" description="Percent watched">
							<visible>Skin.HasSetting(_ShowUnwatched) + [Integer.IsGreater(ListItem.Property(WatchedProgress),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]</visible>
							<posx>167</posx>
							<posy>287</posy>
							<control type="label">
								<selectedcolor>$VAR[HighlightColor]</selectedcolor>
								<posx>0</posx>
								<posy>0</posy>
								<width>58</width>
								<height>26</height>
								<font>size15</font>
								<textcolor>White2</textcolor>
								<shadowcolor>Black</shadowcolor>
								<align>right</align>
								<aligny>center</aligny>
								<label>[B]$VAR[WatchedPercent][/B]</label>
							</control>
						</control>
						<control type="group">
							<visible>container.content(TVshows) | container.content(seasons)</visible>
						<!--<control type="image">
								<visible>Integer.IsGreater(ListItem.Property(UnwatchedEpisodes),0)</visible>
								<right>9</right>
								<top>9</top>
								<height>51</height>
								<width>51</width>
								<aspectratio>keep</aspectratio>
								<texture>overlay/UnwatchedNib.png</texture>
								<colordiffuse>Overlay</colordiffuse>
							</control> -->
							<control type="label" description="Label2">
								<selectedcolor>$VAR[HighlightColor]</selectedcolor>
								<visible>false + Integer.IsGreater(ListItem.Property(UnwatchedEpisodes),0)</visible>
								<right>12</right>
								<top>12</top>
								<height>45</height>
								<width>45</width>
								<font>size16</font>
								<align>center</align>
								<textcolor>$VAR[FocusColor]</textcolor>
								<label>[B]$INFO[ListItem.Property(UnwatchedEpisodes)][/B]</label>
							</control>
						</control>
					</itemlayout>
					<focusedlayout height="320" width="265">
						<control type="image" description="Selection frame (moves with the item, no animation)">
							<posx>7</posx>
							<posy>0</posy>
							<width>251</width>
							<height>345</height>
							<texture border="49" colordiffuse="$VAR[FrameColor]">img/FrameRound.png</texture>
							<bordersize>-9</bordersize>
							<aspectratio>stretch</aspectratio>
						</control>
						<control type="image">
							<visible>ListItem.IsParentFolder</visible>
							<posx>34</posx>
							<posy>24</posy>
							<width>197</width>
							<height>294</height>
							<texture colordiffuse="$VAR[IconColor]" background="true">DefaultFolderBack.png</texture>
							<aspectratio>scale</aspectratio>
						</control>
						<control type="image">
							<visible>!ListItem.IsParentFolder</visible>
							<posx>34</posx>
							<posy>24</posy>
							<width>197</width>
							<height>294</height>
							<texture background="true" diffuse="img/Round_197x294.png">$VAR[Thumb]</texture>
							<aspectratio scalediffuse="false">scale</aspectratio>
						</control>
						<control type="image" description="Overlay">
							<!--<visible>![container.content(TVshows) | container.content(seasons)]</visible>-->
							<posx>195</posx>
							<posy>285</posy>
							<height>30</height>
							<width>30</width>
							<aspectratio>keep</aspectratio>
							<texture>$VAR[OverlayPercent]</texture>
						</control>
						<control type="group" description="Percent watched">
							<visible>Skin.HasSetting(_ShowUnwatched) + [Integer.IsGreater(ListItem.Property(WatchedProgress),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]</visible>
							<posx>167</posx>
							<posy>287</posy>
							<control type="label">
								<posx>0</posx>
								<posy>0</posy>
								<width>58</width>
								<height>26</height>
								<font>size15</font>
								<textcolor>White2</textcolor>
								<shadowcolor>Black</shadowcolor>
								<align>right</align>
								<aligny>center</aligny>
								<label>[B]$VAR[WatchedPercent][/B]</label>
							</control>
						</control>
						<control type="group">
							<visible>container.content(TVshows) | container.content(seasons)</visible>
						<!--<control type="image">
								<visible>Integer.IsGreater(ListItem.Property(UnwatchedEpisodes),0)</visible>
								<right>9</right>
								<top>9</top>
								<height>51</height>
								<width>51</width>
								<aspectratio>keep</aspectratio>
								<texture>overlay/UnwatchedNib.png</texture>
								<colordiffuse>Overlay</colordiffuse>
							</control> -->
							<control type="label" description="Label2">
								<visible>false + Integer.IsGreater(ListItem.Property(UnwatchedEpisodes),0)</visible>
								<right>12</right>
								<top>12</top>
								<height>45</height>
								<width>45</width>
								<font>size16</font>
								<align>center</align>
								<textcolor>$VAR[FocusColor]</textcolor>
								<label>[B]$INFO[ListItem.Property(UnwatchedEpisodes)][/B]</label>
							</control>
						</control>
					</focusedlayout>
				</control>
				<control type="group" description="Media info">
					<animation effect="fade" time="400">Visible</animation>
					<animation effect="fade" time="0">Hidden</animation>
					<posx>70</posx>
					<posy>0</posy>

					<control type="group" description="Media info Top">
						<posx>0</posx>
						<posy>180</posy>
						<control type="image" description="Sets">
							<visible>!Skin.HasSetting(HideSetsIcon)</visible>
							<visible>String.Contains(ListItem.Path,videodb://movies/sets/)</visible>
							<posx>-57</posx>
							<posy>-10</posy>
							<height>33</height>
							<width>60</width>
							<aspectratio>keep</aspectratio>
							<texture>badges/setsFO.png</texture>
						</control>
						<control type="image" description="Clear logo in place of the title (Skin settings > General > Show clear logos). Bottom sits where the title text was; grows upward into free space.">
							<visible>$EXP[ShowClearLogo]</visible>
							<posx>0</posx>
							<posy>-96</posy>
							<width>690</width>
							<height>120</height>
							<aspectratio align="left" aligny="bottom">keep</aspectratio>
							<texture background="true">$INFO[ListItem.Art(clearlogo)]</texture>
						</control>
						<control type="label" description="Main Label">
							<visible>!$EXP[ShowClearLogo]</visible>
							<posy>-12</posy>
							<width>690</width>
							<font>size22B</font>
							<textcolor>$VAR[FocusColor]</textcolor>
							<include>Genre51Commons</include>
							<label>$INFO[ListItem.Label]</label>
						</control>
						<control type="textbox" description="Plot51">
							<visible>!ListItem.IsParentFolder</visible>
							<width>690</width>
							<height>624</height>
							<include>Plot51Commons</include>
							<label fallback="31979">$VAR[Plots]</label>
						</control>
					</control>
					<control type="group" description="Media Info Bottom">
						<visible>!ListItem.IsParentFolder</visible>
						<visible>!Container.Content(MusicVideos)</visible>
						<posx>0</posx>
						<posy>816</posy>
						<control type="label" description="MPAA">
							<posy>90</posy>
							<width>690</width>
							<textcolor>White</textcolor>
							<include>Genre51Commons</include>
							<label>$INFO[ListItem.MPAA,[COLOR=Grey]$LOCALIZE[20074]:[/COLOR] ]</label>
						</control>
						<control type="label" description="Genre">
							<visible>!container.content(episodes)</visible>
							<width>690</width>
							<posy>130</posy>
							<textcolor>White</textcolor>
							<include>Genre51Commons</include>
							<label>$INFO[ListItem.Genre,[COLOR=Grey]$LOCALIZE[515]:[/COLOR] ]</label>
						</control>
						<control type="label" description="Genre">
							<visible>container.content(episodes)</visible>
							<posy>130</posy>
							<width>690</width>
							<textcolor>White</textcolor>
							<include>Genre51Commons</include>
							<label>$INFO[ListItem.RatingAndVotes,[COLOR=Grey]$LOCALIZE[563]:[/COLOR] ]</label>
						</control>
						<control type="label" description="Details">
							<visible>!String.Contains(ListItem.Path,videodb://movies/sets/)</visible>
							<textcolor>White</textcolor>
							<posy>171</posy>
							<width>690</width>
							<include>Genre51Commons</include>
							<label>$VAR[500TopLabel,[COLOR=Grey]$LOCALIZE[33029]:[/COLOR] ]</label>
						</control>
					</control>
				</control>
			</control>
		</control>
	</include>
</includes>