	<expression name="CustomSec3HasItems">!String.IsEmpty(Skin.String(CustomSec3.1.Path)) | !String.IsEmpty(Skin.String(CustomSec3.2.Path)) | !String.IsEmpty(Skin.String(CustomSec3.3.Path)) | !String.IsEmpty(Skin.String(CustomSec3.4.Path)) | !String.IsEmpty(Skin.String(CustomSec3.5.Path)) | !String.IsEmpty(Skin.String(CustomSec3.6.Path)) | !String.IsEmpty(Skin.String(CustomSec3.7.Path)) | !String.IsEmpty(Skin.String(CustomSec3.8.Path)) | !String.IsEmpty(Skin.String(CustomSec3.9.Path)) | !String.IsEmpty(Skin.String(CustomSec3.10.Path)) | !String.IsEmpty(Skin.String(CustomSec3.11.Path)) | !String.IsEmpty(Skin.String(CustomSec3.12.Path)) | !String.IsEmpty(Skin.String(CustomSec3.13.Path)) | !String.IsEmpty(Skin.String(CustomSec3.14.Path)) | !String.IsEmpty(Skin.String(CustomSec3.15.Path)) | !String.IsEmpty(Skin.String(CustomSec3.16.Path)) | !String.IsEmpty(Skin.String(CustomSec3.17.Path)) | !String.IsEmpty(Skin.String(CustomSec3.18.Path)) | !String.IsEmpty(Skin.String(CustomSec3.19.Path)) | !String.IsEmpty(Skin.String(CustomSec3.20.Path))</expression>
	<!-- FOCUS COLOR OVERRIDE. An add-on can put [COLOR] formatting in a name, and Kodi lets that beat our focus color; a skin cannot strip it. The one thing Kodi ignores it for is a DISABLED stand-alone label (drawn in one solid color). So when the focused name has color formatting and no clean title, a disabled label in the focus color takes the place of the focused row's own label (see FocusColorOverride in CommonViews.xml). FocusedLabelColorTagged is the condition of the Focus animation that hides the row's own label (used inside the list row); Container50LabelColorTagged shows the replacement (used outside the list). Keep the two in step. -->
	<!-- Focus box and focused text color. Focused text takes the focus color, except when the box is shown (Hide focus box off) and its sub-setting
	     "Plain text in the focus box" (FocusBoxPlainText) is on: then the box alone marks the focused row and the text keeps its normal color.
	     Select dialogs always show the box in the OSD pickers and the color pickers, so there the sub-setting applies whatever Hide focus box says.
	     The four expressions below only redraw add-on-colored names in the focus color while the box is hidden (see also FocusTextColor,
	     DialogFocusTextColor and FocusListLabel in Includes_Variables.xml). -->
	<expression name="FocusedLabelColorTagged">[[String.Contains(ListItem.Label,COLOR) | String.Contains(ListItem.Label,color) | String.Contains(ListItem.Label,Color)] + [String.IsEmpty(ListItem.Title) | [String.Contains(ListItem.Title,COLOR) | String.Contains(ListItem.Title,color) | String.Contains(ListItem.Title,Color)]]] + [Skin.HasSetting(NoFocusBox) | !Skin.HasSetting(FocusBoxPlainText)]</expression>
	<expression name="Container50LabelColorTagged">[[String.Contains(Container(50).ListItem.Label,COLOR) | String.Contains(Container(50).ListItem.Label,color) | String.Contains(Container(50).ListItem.Label,Color)] + [String.IsEmpty(Container(50).ListItem.Title) | [String.Contains(Container(50).ListItem.Title,COLOR) | String.Contains(Container(50).ListItem.Title,color) | String.Contains(Container(50).ListItem.Title,Color)]]] + [Skin.HasSetting(NoFocusBox) | !Skin.HasSetting(FocusBoxPlainText)]</expression>
	<expression name="Container51LabelColorTagged">[[String.Contains(Container(51).ListItem.Label,COLOR) | String.Contains(Container(51).ListItem.Label,color) | String.Contains(Container(51).ListItem.Label,Color)] + [String.IsEmpty(Container(51).ListItem.Title) | [String.Contains(Container(51).ListItem.Title,COLOR) | String.Contains(Container(51).ListItem.Title,color) | String.Contains(Container(51).ListItem.Title,Color)]]] + [Skin.HasSetting(NoFocusBox) | !Skin.HasSetting(FocusBoxPlainText)]</expression>
	<expression name="DialogRowColorTagged">[[String.Contains(ListItem.Label,COLOR) | String.Contains(ListItem.Label,color) | String.Contains(ListItem.Label,Color)] + [String.IsEmpty(ListItem.Title) | [String.Contains(ListItem.Title,COLOR) | String.Contains(ListItem.Title,color) | String.Contains(ListItem.Title,Color)]] + String.IsEmpty(ListItem.Property(PlainLabel)) + String.IsEmpty(ListItem.Property(KeepColor))] + [[Skin.HasSetting(NoFocusBox) + !Window.IsVisible(VideoFullScreen.xml) + String.IsEmpty(Window(Home).Property(onyx.boxalways))] | !Skin.HasSetting(FocusBoxPlainText)]</expression>
	<expression name="isEnabledScrollbar">!Skin.HasSetting(_ScrollbarsOff)</expression>
	<expression name="BGvideoPlaying">Player.HasVideo + !Skin.HasSetting(BGvideoOff)</expression>
	<expression name="isFanartSourceContextual">Skin.HasSetting(UseFanartSlideshow) + [Skin.HasSetting(FanartSource1) | [!Skin.HasSetting(FanartSource1) + !Skin.HasSetting(FanartSource2) + !Skin.HasSetting(FanartSource3) + !Skin.HasSetting(FanartSource4)]]</expression>
	<expression name="isFanartSourceMovies">Skin.HasSetting(UseFanartSlideshow) + Skin.HasSetting(FanartSource2)</expression>
	<expression name="isFanartSourceTVshows">Skin.HasSetting(UseFanartSlideshow) + Skin.HasSetting(FanartSource3)</expression>
	<expression name="isFanartSourceMusic">Skin.HasSetting(UseFanartSlideshow) + Skin.HasSetting(FanartSource4)</expression>
	<!-- Clear logo instead of the movie / TV show name in the views (Skin settings > General, on by default: the setting stores the "off" state).
	     Only for movie and TV show lists; seasons and episodes keep their text titles. Falls back to the text title when the item has no clear logo. -->
	<expression name="ShowClearLogo">!Skin.HasSetting(ClearLogoOff) + [Container.Content(movies) | Container.Content(tvshows)] + !String.IsEmpty(ListItem.Art(clearlogo))</expression>
	<!-- A TV show or season whose episodes are all watched. Add-ons such as Red Light do not always mark a finished season as played (play count),
	     but publish episode counts instead; Kodi's library sets the same counts. Either watched = total, or unwatched is set and is 0 (a missing
	     UnWatchedEpisodes would read as 0, so it must be non-empty). Used by OverlayNoUnwatched for the watched check mark. -->
	<expression name="AllEpisodesWatched">Integer.IsGreater(ListItem.Property(TotalEpisodes),0) + [String.IsEqual(ListItem.Property(WatchedEpisodes),ListItem.Property(TotalEpisodes)) | [!String.IsEmpty(ListItem.Property(UnWatchedEpisodes)) + Integer.IsEqual(ListItem.Property(UnWatchedEpisodes),0)]]</expression>
	<!-- Power menu (DialogButtonMenu.xml): which items show. Picked in Skin settings > General > Power menu items (CustomPowerMenu.xml); an item the device cannot do stays hidden. -->
	<expression name="PowerMenuRestartApp">Skin.HasSetting(PowerMenuRestartApp) + [System.Platform.Windows | [System.Platform.Linux + !System.Platform.Android]]</expression>
	<expression name="PowerMenuMinimise">Skin.HasSetting(PowerMenuMinimise) + [System.Platform.Windows | System.Platform.OSX | [System.Platform.Linux + !System.Platform.Android]]</expression>
	<expression name="PowerMenuShutdown">!Skin.HasSetting(PowerMenuHideShutdown) + System.CanPowerDown</expression>
	<expression name="PowerMenuSuspend">!Skin.HasSetting(PowerMenuHideSuspend) + System.CanSuspend</expression>
	<expression name="PowerMenuHibernate">Skin.HasSetting(PowerMenuHibernate) + System.CanHibernate</expression>
	<expression name="PowerMenuReboot">!Skin.HasSetting(PowerMenuHideReboot) + System.CanReboot</expression>
	<expression name="PowerMenuTimer">Skin.HasSetting(PowerMenuTimer)</expression>
	<expression name="PowerMenuLogOff">Skin.HasSetting(PowerMenuLogOff) + [System.HasLoginScreen | Integer.IsGreater(System.ProfileCount,1)]</expression>
	<expression name="PowerMenuMasterMode">Skin.HasSetting(PowerMenuMasterMode) + System.HasLocks</expression>
	<expression name="PowerMenuReloadSkin">Skin.HasSetting(PowerMenuReloadSkin)</expression>
