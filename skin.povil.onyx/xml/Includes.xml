	<!-- HOME WIDGET SLOTS (seconds after Home appears; 1 second is the smallest step Kodi skin timers allow). A widget only takes a slot if it is actually in use:
	     its section is shown AND it is set to an add-on widget with a path. WidgetAddon<name> = that test. Library widgets (default Movies / TV shelves, Live TV)
	     are built into Kodi, so they just load at 1 second. Each add-on widget loads at 1 second + 1 for every add-on widget ahead of it (order: Movies, TV,
	     Custom 1, Custom 2, Custom 3), so unused or hidden widgets cost no waiting time. If you see a crash after playback, change 1 to 2 in HomeStageLib and
	     in the "+ 1" below. To add a widget: add a WidgetAddon expression, extend the lists below, and add a Gate variable in Includes_Variables.xml. -->
	<expression name="WidgetAddonMovies">[!Skin.HasSetting(MoviesSectionHide) + !Skin.HasSetting(MoviesShelf_Image) + !Skin.HasSetting(MoviesShelf_Custom) + $EXP[MoviesShelfAddon]]</expression>
	<expression name="WidgetAddonTV">[[!Skin.HasSetting(TVSectionHide) | [System.HasPVRAddon + Skin.HasSetting(PVRSectionHide)]] + !Skin.HasSetting(TVShelf_Image) + !Skin.HasSetting(TVShelf_Custom) + $EXP[TVShelfAddon]]</expression>
	<expression name="WidgetAddonCustomSec1">[!Skin.HasSetting(CustomSec1Hide) + Skin.HasSetting(CustomSec1Shelf_Addon) + !String.IsEmpty(Skin.String(CustomSec1Shelf.Path))]</expression>
	<expression name="WidgetAddonCustomSec2">[!Skin.HasSetting(CustomSec2Hide) + Skin.HasSetting(CustomSec2Shelf_Addon) + !String.IsEmpty(Skin.String(CustomSec2Shelf.Path))]</expression>
	<expression name="WidgetAddonCustomSec3">[!Skin.HasSetting(CustomSec3Hide) + Skin.HasSetting(CustomSec3Shelf_Addon) + !String.IsEmpty(Skin.String(CustomSec3Shelf.Path))]</expression>
	<expression name="HomeStageLib">[Skin.TimerIsRunning(home_widgets) + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),1)]</expression>
	<expression name="HomeStagePVR">$EXP[HomeStageLib]</expression>
	<expression name="HomeStageMoviesAddon">[Skin.TimerIsRunning(home_widgets) + [[Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),1)]]]</expression>
	<expression name="HomeStageTVAddon">[Skin.TimerIsRunning(home_widgets) + [[$EXP[WidgetAddonMovies] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),1)]]]</expression>
	<expression name="HomeStageCustomSec1Addon">[Skin.TimerIsRunning(home_widgets) + [[$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),1)]]]</expression>
	<expression name="HomeStageCustomSec2Addon">[Skin.TimerIsRunning(home_widgets) + [[$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),4)] | [$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),1)]]]</expression>
	<expression name="HomeStageCustomSec3Addon">[Skin.TimerIsRunning(home_widgets) + [[$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),5)] | [$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),4)] | [$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),4)] | [$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),4)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),4)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [!$EXP[WidgetAddonMovies] + $EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),3)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + $EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + $EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),2)] | [!$EXP[WidgetAddonMovies] + !$EXP[WidgetAddonTV] + !$EXP[WidgetAddonCustomSec1] + !$EXP[WidgetAddonCustomSec2] + Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(home_widgets),1)]]]</expression>
