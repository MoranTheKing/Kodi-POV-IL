<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_510" description="All Video Views">
		<control type="group" description="Fanart 3">
			<visible>Control.IsVisible(510)</visible>
			<control type="fixedlist" id="510" description="Fanart 3 for episodes and files">
				<visible>![Container.content(movies) | container.content(seasons) | container.content(tvshows)]</visible>
				<onup condition="!Skin.HasSetting(ViewOptions_Hide)">9000</onup>
				<ondown condition="!Skin.HasSetting(ViewOptions_Hide)">9000</ondown>
				<onleft>510</onleft>
				<onright>510</onright>
				<viewtype label="$LOCALIZE[20445] 3">Fanart 3</viewtype>
				<!-- 4 full items from the left edge (same as the music Fanart 3 in MyMusicNav.xml): first item opens in slot 1, focus scrolls in slot 2, last item can reach slot 4 -->
				<posx>72</posx>
				<posy>690</posy>
				<width>1776</width>
				<height>402</height>
				<orientation>horizontal</orientation>
				<scrolltime>400</scrolltime>
				<focusposition>1</focusposition>
				<movement>2</movement>
				<preloaditems>4</preloaditems>
				<pagecontrol>60</pagecontrol>
				<itemlayout height="357" width="444">
					<control type="image" description="Thumb">
						<posx>27</posx>
						<posy>27</posy>
						<width>393</width>
						<height>303</height>
						<texture fallback="DefaultFolder.png" background="true" diffuse="img/Round_393x303.png">$INFO[ListItem.Thumb]</texture>
						<aspectratio scalediffuse="false">scale</aspectratio>
					</control>
					<control type="image" description="Watched mark">
						<visible>Container.Content(episodes)</visible>
						<posx>385</posx>
						<posy>291</posy>
						<width>30</width>
						<height>30</height>
						<texture>$VAR[OverlayPercent]</texture>
						<aspectratio>keep</aspectratio>
					</control>
					<control type="group" description="Percent watched">
						<visible>Container.Content(episodes) + Skin.HasSetting(_ShowUnwatched) + [Integer.IsGreater(ListItem.Property(WatchedProgress),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]</visible>
						<posx>357</posx>
						<posy>293</posy>
						<control type="label">
							<selectedcolor>$VAR[HighlightColor]</selectedcolor>
							<posx>0</posx>
							<posy>0</posy>
							<width>58</width>
							<height>26</height>
							<font>size15</font>
							<textcolor>White2</textcolor>
							<shadowcolor>Black</shadowcolor>
							<align>right</align>
							<aligny>center</aligny>
							<label>[B]$VAR[WatchedPercent][/B]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="357" width="444">
					<control type="image" description="Selection frame (part of the focused item, no animation)">
						<posx>1</posx>
						<posy>2</posy>
						<width>445</width>
						<height>354</height>
						<texture border="49" colordiffuse="$VAR[FrameColor]">img/FrameRound.png</texture>
						<bordersize>-9</bordersize>
						<aspectratio>stretch</aspectratio>
					</control>
					<control type="group">
						<control type="image" description="Thumb">
							<posx>27</posx>
							<posy>27</posy>
							<width>393</width>
							<height>303</height>
							<texture fallback="DefaultFolder.png" background="true" diffuse="img/Round_393x303.png">$INFO[ListItem.Thumb]</texture>
							<aspectratio scalediffuse="false">scale</aspectratio>
						</control>
						<control type="image" description="Watched mark">
							<visible>Container.Content(episodes)</visible>
							<posx>385</posx>
							<posy>291</posy>
							<width>30</width>
							<height>30</height>
							<texture>$VAR[OverlayPercent]</texture>
							<aspectratio>keep</aspectratio>
						</control>
						<control type="group" description="Percent watched">
							<visible>Container.Content(episodes) + Skin.HasSetting(_ShowUnwatched) + [Integer.IsGreater(ListItem.Property(WatchedProgress),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]</visible>
							<posx>357</posx>
							<posy>293</posy>
							<control type="label">
								<posx>0</posx>
								<posy>0</posy>
								<width>58</width>
								<height>26</height>
								<font>size15</font>
								<textcolor>White2</textcolor>
								<shadowcolor>Black</shadowcolor>
								<align>right</align>
								<aligny>center</aligny>
								<label>[B]$VAR[WatchedPercent][/B]</label>
							</control>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="group" description="Media Info">
				<visible>!Container.Content(episodes)</visible>
				<posy>622</posy>
				<control type="label" description="Item Title">
					<posx>0</posx>
					<posy>0</posy>
					<font>size22B</font>
					<textcolor>$VAR[FocusColor]</textcolor>
					<width>1920</width>
					<align>center</align>
					<include>Genre51Commons</include>
					<label>$INFO[ListItem.Label][COLOR=White]$INFO[ListItem.Label2, • ][/COLOR]</label>
				</control>
				<control type="image" description="Line Split">
					<posx>15</posx>
					<posy>60</posy>
					<width>1890</width>
					<height>1</height>
					<texture>img/LineST.png</texture>
					<aspectratio>stretch</aspectratio>
				</control>
			</control>
			<control type="group" description="Media Info">
				<visible>Container.Content(episodes)</visible>
				<posy>428</posy>
				<control type="image">
					<posx>64</posx>
					<posy>12</posy>
					<width>30</width>
					<height>30</height>
					<texture>$VAR[OverlayNoUnwatched]</texture>
					<aspectratio>keep</aspectratio>
				</control>
				<control type="group" description="Left">
					<posx>98</posx>
					<posy>63</posy>
					<control type="label" description="Item Title">
						<posy>-57</posy>
						<font>size22B</font>
						<textcolor>$VAR[FocusColor]</textcolor>
						<width>750</width>
						<include>Genre51Commons</include>
						<info>ListItem.Label</info>
					</control>
					<control type="image" description="Line Split">
						<posx>0</posx>
						<posy>189</posy>
						<width>1725</width>
						<height>1</height>
						<texture>img/LineST.png</texture>
						<aspectratio>stretch</aspectratio>
					</control>
					<control type="textbox" description="Plot (5 lines of size20 = 5 x 36; bottom stays just above the split line, longer plots auto-scroll)">
						<posy>3</posy>
						<posx>0</posx>
						<width>802</width>
						<height>180</height>
						<font>size20</font>
						<textcolor>Silver</textcolor>
						<align>justify</align>
						<aligny>bottom</aligny>
						<autoscroll delay="8000" time="4300" repeat="10000">!Skin.HasSetting(_AutoScrollOff)</autoscroll>
						<label>$VAR[Plots]</label>
					</control>
				</control>
				<control type="group" description="Right">
					<posx>1020</posx>
					<posy>30</posy>
					<control type="label" description="Genre">
						<posy>90</posy>
						<include>Genre500Commons</include>
						<label>$INFO[ListItem.Season,$LOCALIZE[20373] ]: $INFO[ListItem.Episode, $LOCALIZE[20359] ]</label>
					</control>
					<control type="label" description="MPAA">
						<posy>130</posy>
						<include>Genre500Commons</include>
						<label>$LOCALIZE[20074]: $INFO[ListItem.MPAA]</label>
					</control>
					<control type="grouplist">
						<posx>0</posx>
						<posy>171</posy>
						<width>auto</width>
						<height>33</height>
						<orientation>horizontal</orientation>
						<align>left</align>
						<itemgap>30</itemgap>
						<control type="label" description="Details">
							<height>33</height>
							<width max="735">auto</width>
							<include>Genre500Commons</include>
							<label>$VAR[500TopLabel]$INFO[ListItem.Rating, • ]</label>
						</control>
						<control type="image">
							<visible>$EXP[IsVideoHD]</visible>
							<width>40</width>
							<height>39</height>
							<aspectratio>keep</aspectratio>
							<texture>$INFO[ListItem.VideoResolution,badges/,.png]</texture>
						</control>
					</control>
				</control>
			</control>
		</control>
	</include>
</includes>