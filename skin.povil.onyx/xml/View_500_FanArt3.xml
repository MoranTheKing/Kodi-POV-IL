<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<include name="View_500" description="All Video Views">
		<control type="group" description="Fanart 3">
			<visible>Control.IsVisible(500)</visible>
			<control type="fixedlist" id="500" description="TOP Shortcuts">
				<visible>Container.content(movies) | container.content(seasons) | Container.content(tvshows)</visible>
				<pagecontrol>60</pagecontrol>
				<onup condition="!Skin.HasSetting(ViewOptions_Hide)">9000</onup>
				<ondown condition="$EXP[isEnabledScrollbar]">9003</ondown>
				<onleft>500</onleft>
				<onright>500</onright>
				<viewtype label="$LOCALIZE[20445] 3">Fanart 3</viewtype>
				<posx>-183</posx>
				<posy>670</posy>
				<width>2286</width>
				<height>422</height>
				<orientation>horizontal</orientation>
				<focusposition>4</focusposition>
				<movement>3</movement>
				<preloaditems>4</preloaditems>
				<itemlayout condition="container.Content(Movies) | container.content(TVShows) | container.content(Seasons)" height="387" width="254">
					<control type="image" description="Thumb">
						<visible>ListItem.IsParentFolder</visible>
						<posx>8</posx>
						<posy>23</posy>
						<width>222</width>
						<height>333</height>
						<texture colordiffuse="$VAR[IconColor]" background="true">DefaultFolderBack.png</texture>
						<aspectratio>scale</aspectratio>
					</control>
					<control type="image" description="Thumb">
						<visible>!ListItem.IsParentFolder</visible>
						<posx>8</posx>
						<posy>23</posy>
						<width>222</width>
						<height>333</height>
						<texture background="true" diffuse="img/Round_222x333.png">$VAR[Thumb]</texture>
						<aspectratio scalediffuse="false">scale</aspectratio>
					</control>
					<control type="image">
						<posx>195</posx>
						<posy>317</posy>
						<width>30</width>
						<height>30</height>
						<texture>$VAR[OverlayPercent]</texture>
						<aspectratio>keep</aspectratio>
					</control>
					<control type="group" description="Percent watched">
						<visible>Skin.HasSetting(_ShowUnwatched) + [Integer.IsGreater(ListItem.Property(WatchedProgress),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]</visible>
						<posx>167</posx>
						<posy>319</posy>
						<control type="label">
							<selectedcolor>$VAR[HighlightColor]</selectedcolor>
							<posx>0</posx>
							<posy>0</posy>
							<width>58</width>
							<height>26</height>
							<font>size15</font>
							<textcolor>White2</textcolor>
							<shadowcolor>Black</shadowcolor>
							<align>right</align>
							<aligny>center</aligny>
							<label>[B]$VAR[WatchedPercent][/B]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout condition="container.Content(Movies) | container.content(TVShows) | container.content(Seasons)" height="387" width="254">
					<control type="image" description="Selection frame (part of the focused item, no animation)">
						<posx>-17</posx>
						<posy>-1</posy>
						<width>272</width>
						<height>384</height>
						<texture border="49" colordiffuse="$VAR[FrameColor]">img/FrameRound.png</texture>
						<bordersize>-9</bordersize>
						<aspectratio>stretch</aspectratio>
					</control>
					<control type="image" description="Thumb">
						<visible>ListItem.IsParentFolder</visible>
						<posx>8</posx>
						<posy>23</posy>
						<width>222</width>
						<height>333</height>
						<texture colordiffuse="$VAR[IconColor]" background="true">DefaultFolderBack.png</texture>
						<aspectratio>scale</aspectratio>
					</control>
					<control type="image" description="Thumb">
						<visible>!ListItem.IsParentFolder</visible>
						<posx>8</posx>
						<posy>23</posy>
						<width>222</width>
						<height>333</height>
						<texture background="true" diffuse="img/Round_222x333.png">$VAR[Thumb]</texture>
						<aspectratio scalediffuse="false">scale</aspectratio>
					</control>
					<control type="image">
						<posx>195</posx>
						<posy>317</posy>
						<width>30</width>
						<height>30</height>
						<texture>$VAR[OverlayPercent]</texture>
						<aspectratio>keep</aspectratio>
					</control>
					<control type="group" description="Percent watched">
						<visible>Skin.HasSetting(_ShowUnwatched) + [Integer.IsGreater(ListItem.Property(WatchedProgress),0) | Integer.IsGreater(ListItem.PercentPlayed,0)]</visible>
						<posx>167</posx>
						<posy>319</posy>
						<control type="label">
							<posx>0</posx>
							<posy>0</posy>
							<width>58</width>
							<height>26</height>
							<font>size15</font>
							<textcolor>White2</textcolor>
							<shadowcolor>Black</shadowcolor>
							<align>right</align>
							<aligny>center</aligny>
							<label>[B]$VAR[WatchedPercent][/B]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="group" description="Media Info">
				<left>82</left>
				<top>132</top>
				<control type="image" description="Clear logo in place of the title (Skin settings > General > Show clear logos). Bottom sits where the title text was; grows upward into free space.">
					<visible>$EXP[ShowClearLogo]</visible>
					<posx>0</posx>
					<posy>-18</posy>
					<width>700</width>
					<height>150</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<texture background="true">$INFO[ListItem.Art(clearlogo)]</texture>
				</control>
				<control type="label" description="Item Title">
					<visible>!$EXP[ShowClearLogo]</visible>
					<top>96</top>
					<font>size22B</font>
					<textcolor>$VAR[FocusColor]</textcolor>
					<width>900</width>
					<include>Genre51Commons</include>
					<info>ListItem.Label</info>
				</control>
				<control type="label" description="MPAA">
					<top>157</top>
					<height>33</height>
					<width>900</width>
					<include>Genre500Commons</include>
					<label>$INFO[ListItem.MPAA]</label>
				</control>
				<control type="label" description="Details (movies: year, length, rating, trailer; TV shows and seasons: year, episodes, rating)">
					<visible>!ListItem.IsFolder | Container.Content(tvshows) | Container.Content(seasons)</visible>
					<top>198</top>
					<height>33</height>
					<width>900</width>
					<include>Genre500Commons</include>
					<label>$VAR[Fanart3Details]</label>
				</control>
				<control type="label" description="Genre">
					<top>236</top>
					<width>900</width>
					<include>Genre500Commons</include>
					<label>$INFO[ListItem.Genre]</label>
				</control>
				<control type="textbox" description="Plot">
					<visible>!ListItem.IsParentFolder</visible>
					<top>290</top>
					<posx>0</posx>
					<width>900</width>
					<height>220</height>
					<align>left</align>
					<autoscroll delay="8000" time="4300" repeat="10000">!Skin.HasSetting(_AutoScrollOff)</autoscroll>
					<label>$VAR[Plots]</label>
				</control>
			</control>
		</control>
	</include>
</includes>