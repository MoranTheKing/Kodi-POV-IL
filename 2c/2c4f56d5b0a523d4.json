{"c":[[3760,7040,"עוצמתי יותר מכוחות גירוש שדים מפחידים."],[9200,12480,"מסתורי יותר מכל אות של גלגול נשמות."],[15200,17720,"החוויה המטלטלת של"],[18240,19570,"הצעקה."],[27840,31340,"אתם מסתכלים על אדם בעל כוחות מסתוריים."],[32990,35960,"שמו צ'ארלס קרוסלי, והוא מלומד להפליא."],[36240,38730,"יש לו את הכוח לקחת את נשמותיהם של אחרים."],[39140,40410,"הו כן, זה נכון."],[41040,43260,"גבר צעיר רוצה אישה שתהיה לו לאישה."],[44530,46800,"הוא גונב ממנה חפץ חסר ערך,"],[47920,49650,"כישוף גבס,"],[50530,52720,"ואז היא לא יכולה לעמוד בפניו."],[55480,56310,"זה מצחיק..."],[57690,58950,"ועוד משהו..."],[59590,61680,"אלן בייטס הוא קרוסלי."],[61680,64840,"אדון הסודות העמוקים ביותר של האדם הקדמון,"],[65340,68950,"וכולם מחווירים לעומת הצעקה הנוראה שלו."],[69180,71370,"לו הייתי צועק עכשיו בשבילך, היית מת."],[72730,73930,"כמו אשתך,"],[74530,76000,"וכל אחד אחר בסביבה."],[76400,78000,"סוזנה יורק היא רייצ'ל."],[78520,81420,"תחילה נשמתה, אחר כך כל הווייתה,"],[81420,84400,"נשלטים על ידי האיש עם הצעקה."],[85040,86450,"ג'ון הרט הוא אנתוני."],[87070,89330,"הסיכוי היחיד שלו לשבור את הכישוף"],[89530,90730,"טמון באבן."],[91140,93300,"אבל איזו אבן ואיפה?"],[96720,99080,"כמה זמן אתה חושב שהוא יישאר?"],[101600,102510,"חודשים."],[103350,105310,"אז כדאי שתעלם מכאן."],[112320,113990,"הוא לא בדיוק נורמלי."],[115400,116980,"אה, ומה זה נורמלי?"],[117770,118890,"זה נורמלי."],[119330,120250,"אתה מכיר את זה?"],[120890,121910,"זהו זה."],[123000,126750,"לא קוסם בחליפה העניק לי כוח איום על אויביי."],[127190,128710,"הוא לימד אותי להשתמש"],[129500,131180,"בצעקת האימה."],[131600,132980,"עכשיו אני יכול להרוג איתה."],[134160,134770,"להרוג"],[135760,136690,"באופן מיידי."],[137210,138440,"התכונן."],[138800,141210,"כל שריר, כל עצב."],[141660,145140,"החוויה המטלטלת והאולטימטיבית של"],[145140,146340,"הצעקה."],[152520,154240,"הצליל הזה נשמע כמוהו,"],[155460,157960,"רק פי אלף יותר גרוע!"],[162660,165630,"הצעקה"]],"s":"manual","m":"gemini-3.1-flash-lite","n":"The Shout","y":1978,"k":"movie","f":2,"ts":1795805561}