{"c":[[1840,3200,"אני עובד ניקיון בלובר."],[4120,5320,"יצירות האמנות שאני מנקה,"],[5400,6760,"שוות מיליונים."],[7840,10680,"ביום שישי הבא, קרן כלשהי תעמיד שרשרת למכירה פומבית."],[10760,12880,"השרשרת הייתה שייכת למארי אנטואנט."],[12960,13880,"אנחנו הולכים לגנוב אותה."],[14400,15680,"ניכנס כעובדי ניקיון..."],[16440,17840,"ונצא מיליונרים."],[18480,19880,"יש שאלות?"],[19960,21880,"בזמן שאנחנו מסכנים את התחת שלנו, מה אתה עושה?"],[21960,23200,"מי, אני?"],[24040,25440,"אני קונה את השרשרת."],[31400,32960,"בגילך, אהבתי לקרוא."],[33400,35800,"סבא שלך נתן לי את זה. אני חושב שתאהב את זה."],[35880,38200,"ארסן לופן, הג'נטלמן הגנב."],[39840,41440,"מצאתי משהו, זה מדהים."],[42680,45040,"הרפתקה קלאסית של ארסן לופן מאת מוריס לבלאן."],[45600,47920,"גם השיטה, הלהט,"],[48480,50600,"הסטייל, הכישרון!"],[51680,53640,"מה הלאה, ד'ארטניאן ושלושת החזירים?"],[57720,59760,"עשרים וחמש שנה האמנתי שאבא שלי גנב."],[59840,60840,"גדלתי עם זה."],[63160,65200,"לפני עשרים וחמש שנה, הוא הפליל את אבא שלי."],[65280,66680,"-נו, קחו אותו. -עזבו אותי!"],[68440,69880,"אתה רוצה לנקום בפלגריני."],[71880,73880,"זה הכל משחק, מפקח."],[74760,75920,"משחק עם חוקים."],[77640,79240,"ואני זה שקובע אותם."],[80280,81720,"זו בדיוק התוכנית שלי."],[90120,91320,"מכיר את תרגיל האזיקים?"],[91400,92360,"איזה תרגיל אזיקים?"],[93480,94680,"טוב, עכשיו אתה מכיר."],[100200,101400,"המעטת בערכי."],[103680,104960,"לא באמת הסתכלת עליי."],[105760,108200,"ראית אותי, אבל לא באמת הסתכלת."],[118520,120080,"רוצה לספר לי מה עשית אתמול בלילה?"],[120160,121000,"לא עשיתי הרבה."],[121080,122040,"אה, אני בטוח."],[124720,126560,"-עכשיו יותר טוב? -תודה."]],"s":"manual","m":"gemini-3.1-flash-lite","n":"לופן","y":2021,"ts":1795237330}