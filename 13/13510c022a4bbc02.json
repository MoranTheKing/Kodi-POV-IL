{"c":[[2300,3610,"פעם שיקרת?"],[3660,4330,"אתה רציני?"],[4380,7340,"שקר הוא לא חלק מתיאור התפקיד ב-CIA?"],[8860,10820,"זה השותף החדש שלי."],[11020,12730,"הוא קצת מקובע על נהלים."],[12780,14490,"אף.בי.איי, לפתוח!"],[14540,18250,"הוא הקריא לי זכויות על שקר לחשוד בדירת מסתור."],[18300,20170,"אז זה חלק מנוהל העבודה אצלכם?"],[20220,22520,"כן, כי זה מאוד אפקטיבי."],[23420,26730,"אחרי ששאלת אותה, פליקס לאנג"],[26780,28810,"נראה שזה בא לך בקלות."],[28860,33560,"עוד הבדל מהותי בין סוכנות ביון לחבורה של פקידים."],[34060,35130,"אני מושך אותם אליי."],[35180,36090,"אתה לא ממש מועיל לי חי,"],[36140,37530,"אבל אתה ממש חסר תועלת כשתהיה מת."],[37580,39540,"לא ידעתי שאכפת לך."],[39740,41210,"אתם עובדים בגלוי."],[41260,43210,"אנחנו עובדים בצללים."],[43260,46920,"שנינו עושים זאת כדי לשמור על המדינה שלנו בטוחה."],[53740,55640,"עבודה טובה, שותף."],[55820,57690,"סי.איי.איי. המשימה מתחילה."],[57740,60280,"CBS, שני, 23 בפברואר."]],"s":"asr","m":"gemini-3.1-flash-lite","n":"סי.איי.איי","y":2026,"k":"tv","e":1,"f":2,"ts":1795246964}